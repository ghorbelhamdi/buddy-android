#!/bin/bash
# Run by the Buddy app inside its built-in Linux (Alpine, through proot).
#   buddy-run <token> ask <session> <claude|codex|opencode|agy|grok> <dev:0|1|rule|play> <message> [model] [attachment-ids]
#     (rule: a notification rule's run, working for someone else's message: no shell, files or web tools;
#      play: the Play version, which has no Linux tools at all)
#                                    run the agent on the message in that session, streaming events to the bubble
#   buddy-run <token> stop <session>       stop that session's running request
#   buddy-run <token> delete <session>     forget that session
#   buddy-run <token> ping                 answer the app's setup check
#   buddy-run <token> procs                list running Claude Code / Codex / OpenCode / Antigravity / Grok processes (buddy_procs)
#   buddy-run <token> kill <pid>           stop a running Claude Code / Codex process and its children
#   buddy-run <token> recent               list recent Claude Code / Codex sessions from their history (buddy_recent)
#   buddy-run <token> transcript <claude|codex> <file>   last messages of a session (buddy_transcript)
#   buddy-run <token> adopt <session> <claude|codex> <agent-session-id>  continue that session as a Buddy chat
# Every event sent to the bubble carries "buddy_session" so the app can route it.
HELPER_VERSION=18
set -u
export PATH=$HOME/.local/bin:$HOME/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# The claude launcher sets BUN_OPTIONS with a path relative to its folder; never inherit a stale one.
unset BUN_OPTIONS
D=$HOME/.buddy
W=$D/work
mkdir -p "$W" "$D/sessions"
TOKEN=${1:-}
CMD=${2:-}
URL=http://127.0.0.1:8765

post() { # post one JSON event to the bubble
  curl -s -m 5 -o /dev/null -X POST -H "Authorization: Bearer $TOKEN" \
    -H 'Content-Type: application/json' --data-binary @- "$URL/event"
}
have() { command -v "$1" >/dev/null 2>&1; }
valid_sid() { [[ "$1" =~ ^[A-Za-z0-9_-]{1,64}$ ]]; }
# OpenCode 2 (npm @opencode/cli) rather than 1.x (opencode-ai)? 2 needs --standalone, or it leaves a background service
oc2() { [[ "$(readlink -f "$(command -v opencode)" 2>/dev/null)" == */@opencode/cli/* ]]; }

# Kill a process and everything it started (claude/codex run a few levels below buddy-run).
kill_tree() {
  local p=$1 c
  for c in $(pgrep -P "$p" 2>/dev/null); do kill_tree "$c"; done
  kill -TERM "$p" 2>/dev/null
}

descendants() { # print a pid and all its descendants
  local p=$1 c
  echo "$p"
  for c in $(pgrep -P "$p" 2>/dev/null); do descendants "$c"; done
}


# Is this pid an agent process (the real claude / codex / opencode / agy / grok program)?
agent_of() {
  local cmd
  cmd=$(tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null) || return 1
  case "${cmd%% *}" in
    */claude/versions/*) echo claude ;;
    */codex-linux-*/*|*/bin/codex) echo codex ;;
    */opencode-ai/*|*/@opencode/cli*/*|*/bin/opencode) echo opencode ;;
    */antigravity-cli/bin/*|*/bin/agy) echo agy ;;
    grok|*/bin/grok|*/grok-linux-*) echo grok ;;
    *) return 1 ;;
  esac
}

case "$CMD" in
  ping) # setup check: proves RUN_COMMAND, the helper and the callback all work
    agents=$({ have claude && echo claude; have codex && echo codex; have opencode && echo opencode; have agy && echo agy
      have grok && echo grok; } | paste -sd, -)
    # signed in = the agent's saved login exists (OpenCode works without one: its free models)
    signed=$({ [ -s "$HOME/.claude/.credentials.json" ] && echo claude; [ -s "$HOME/.codex/auth.json" ] && echo codex
      have opencode && echo opencode; [ -s "$HOME/.gemini/antigravity-cli/antigravity-oauth-token" ] && echo agy
      [ -s "$HOME/.grok/auth.json" ] && echo grok; } | paste -sd, -)
    cm=$(jq -c '[.models[] | select(.visibility == "list") | [.slug, .display_name]]' "$HOME/.codex/models_cache.json" 2>/dev/null)
    # OpenCode's model list (a second or two; a background refresh got killed when the helper exited, so the list
    # never updated and new free models didn't show). On failure the last good list is kept.
    have opencode && timeout 30 opencode models $(oc2 && echo --standalone) >"$D/opencode-models.new" 2>/dev/null \
      && [ -s "$D/opencode-models.new" ] && mv "$D/opencode-models.new" "$D/opencode-models"
    # Antigravity's models ("id<TAB>name" lines; the list depends on the account's plan)
    if have agy && [ -s "$HOME/.gemini/antigravity-cli/antigravity-oauth-token" ]; then
      timeout 30 agy models >"$D/agy-models.new" 2>/dev/null && grep -q "$(printf '\t')" "$D/agy-models.new" \
        && mv "$D/agy-models.new" "$D/agy-models"
    fi
    am=$(jq -Rsc 'split("\n") | map(select(test("^[A-Za-z0-9._-]+\t.")) | split("\t") | [.[0], .[1]])' "$D/agy-models" 2>/dev/null)
    # Grok's ("  * grok-4.7 (default)" lines; its ids are its names)
    if have grok && [ -s "$HOME/.grok/auth.json" ]; then
      timeout 30 grok models >"$D/grok-models.new" 2>/dev/null && grep -q '^ *[*-] ' "$D/grok-models.new" \
        && mv "$D/grok-models.new" "$D/grok-models"
    fi
    gm=$(jq -Rsc 'split("\n") | map(capture("^\\s*[*-]\\s+(?<id>[A-Za-z0-9._-]+)") | [.id, .id])' "$D/grok-models" 2>/dev/null)
    om=$(jq -Rsc 'split("\n") | map(select(test("^[A-Za-z0-9._-]+/\\S+$"))) | map([., (split("/") | .[1:] | join("/"))])' "$D/opencode-models" 2>/dev/null)
    jq -cn --arg s "${agents:-none}" --arg g "${signed:-none}" --argjson v "$HELPER_VERSION" --argjson cm "${cm:-[]}" \
      --argjson om "${om:-[]}" --argjson am "${am:-[]}" --argjson gm "${gm:-[]}" \
      '{type:"buddy_pong",text:$s,signed:$g,helper:$v,codex_models:$cm,opencode_models:$om,agy_models:$am,grok_models:$gm}' | post
    exit 0 ;;
  procs)
    # map every process started by a Buddy chat to that chat
    declare -A owner=()
    for f in "$D"/sessions/*/pid; do
      [ -f "$f" ] || continue
      sid=$(basename "$(dirname "$f")")
      for q in $(descendants "$(cat "$f")"); do owner[$q]=$sid; done
    done
    {
      for p in $(pgrep -f 'claude/versions/|codex-linux-|/bin/codex|opencode-ai/|@opencode/cli|/bin/opencode|antigravity-cli/bin/|/bin/agy|^grok( |$)|/bin/grok|grok-linux-' 2>/dev/null); do
        a=$(agent_of "$p") || continue
        [ "$p" = "$$" ] && continue
        cwd=$(readlink "/proc/$p/cwd" 2>/dev/null)
        et=$(ps -o etimes= -p "$p" 2>/dev/null | tr -d ' ')
        args=$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | cut -c1-300)
        # what kind of process: Claude Code's background service, a session it hosts, or a terminal session
        pargs=$(tr '\0' ' ' < "/proc/$(ps -o ppid= -p "$p" | tr -d ' ')/cmdline" 2>/dev/null)
        kind=terminal
        case "$args" in *" daemon run"*) kind=daemon ;; esac
        [ "$kind" = terminal ] && case "$pargs" in *bg-pty-host*) kind=background ;; esac
        # its conversation: --session-id wins (a fork gets a new id), else --resume <id>
        ses=$(printf '%s' "$args" | grep -oE -- '--session-id [0-9a-f-]{36}' | head -1 | cut -d' ' -f2)
        [ -z "$ses" ] && ses=$(printf '%s' "$args" | grep -oE -- '--resume [0-9a-f-]{36}' | head -1 | cut -d' ' -f2)
        title=""
        if [ -n "$ses" ] && [ "$a" = claude ]; then
          f=$(ls "$HOME"/.claude/projects/*/"$ses".jsonl 2>/dev/null | head -1)
          [ -n "$f" ] && title=$(head -n 400 "$f" | jq -r 'select(.type=="user") | .message.content
            | if type=="string" then . else ([.[]? | select(.type=="text") | .text] | join(" ")) end
            | select(. != "" and (startswith("<") | not) and (startswith("This session is being continued") | not)
                and (startswith("Caveat:") | not))' 2>/dev/null | head -1 | tr '\n' ' ' | cut -c1-80)
        fi
        jq -cn --argjson pid "$p" --arg agent "$a" --arg cwd "$cwd" --arg et "${et:-0}" \
          --arg args "$args" --arg buddy "${owner[$p]:-}" --arg kind "$kind" --arg ses "$ses" --arg title "$title" \
          '{pid:$pid, agent:$agent, cwd:$cwd, seconds:($et|tonumber), args:$args, buddy:$buddy,
            kind:$kind, session:$ses, title:$title}'
      done
    } | jq -cs '{type:"buddy_procs", procs:.}' | post
    exit 0 ;;
  kill)
    P=${3:-}
    [[ "$P" =~ ^[0-9]+$ ]] && agent_of "$P" >/dev/null || exit 2   # only ever kill claude/codex/opencode/agy/grok
    kill_tree "$P"
    exit 0 ;;
  recent)
    {
      # skip the Remote Control session's folder (RemoteSession.DIR): it must not be adopted while it runs
      for f in $(ls -t "$HOME"/.claude/projects/*/*.jsonl 2>/dev/null | grep -v '/-root-remote/' | head -15); do
        head -n 300 "$f" | jq -c --arg f "$f" --arg m "$(stat -c %Y "$f")" -s '
          ([.[] | select(.type=="user") | .message.content
                | if type=="string" then . else ([.[]? | select(.type=="text") | .text] | join(" ")) end
                | select(. != "" and (startswith("<")|not) and (startswith("This session is being continued")|not)
                    and (startswith("Caveat:")|not))] | first // "") as $t
          | {agent:"claude", file:$f, id:($f|split("/")|last|rtrimstr(".jsonl")),
             cwd:([.[]|.cwd//empty]|first//""), title:($t|.[0:120]), mtime:($m|tonumber)}' 2>/dev/null
      done
      for f in $(find "$HOME/.codex/sessions" -name '*.jsonl' 2>/dev/null | xargs -r ls -t 2>/dev/null | head -15); do
        head -n 80 "$f" | jq -c --arg f "$f" --arg m "$(stat -c %Y "$f")" -s '
          ([.[] | select(.type=="session_meta") | .payload] | first // {}) as $meta
          | ([.[] | select(.type=="response_item" and .payload.type=="message" and .payload.role=="user")
                | .payload.content[]? | .text // empty
                | select(startswith("<")|not)
                | (if contains("User message from the Buddy bubble:\n") then split("User message from the Buddy bubble:\n")|last else . end)]
             | last // "") as $t
          | {agent:"codex", file:$f, id:($meta.id//""), cwd:($meta.cwd//""), title:($t|.[0:120]),
             mtime:($m|tonumber)}' 2>/dev/null
      done
    } | jq -cs --argjson own "$(for f in "$D"/sessions/*/claude-session "$D"/sessions/*/codex-thread; do
          [ -f "$f" ] && jq -cn --arg k "$(cat "$f")" --arg v "$(basename "$(dirname "$f")")" '{($k):$v}'
        done | jq -cs 'add // {}')" \
      '{type:"buddy_recent", sessions:(sort_by(-.mtime)|.[0:25]|map(. + {buddy:($own[.id] // "")}))}' | post
    exit 0 ;;
  transcript)
    A=${3:-}; F=${4:-}
    case "$F" in "$HOME"/.claude/projects/*.jsonl|"$HOME"/.codex/sessions/*.jsonl) ;; *) exit 2 ;; esac
    [ -f "$F" ] || exit 2
    if [ "$A" = claude ]; then
      tail -n 600 "$F" | jq -c 'select(.type=="user" or .type=="assistant")
        | {role:.message.role, text:(if (.message.content|type)=="string" then .message.content
            else ([.message.content[]? | select(.type=="text") | .text] | join("\n")) end)}
        | select(.text != "" and (.text|startswith("<")|not))' 2>/dev/null
    else
      tail -n 600 "$F" | jq -c 'select(.type=="response_item" and .payload.type=="message"
          and (.payload.role=="user" or .payload.role=="assistant"))
        | {role:.payload.role, text:([.payload.content[]? | .text // empty] | join("\n"))}
        | select(.text != "" and (.text|startswith("<")|not))' 2>/dev/null
    fi | tail -n 40 | jq -cs --arg f "$F" '{type:"buddy_transcript", file:$f, messages:map(.text |= .[0:2000])}' | post
    exit 0 ;;
  adopt)
    SID=${3:-}; A=${4:-}; AID=${5:-}
    valid_sid "$SID" && [[ "$AID" =~ ^[A-Za-z0-9-]{8,64}$ ]] || exit 2
    mkdir -p "$D/sessions/$SID"
    if [ "$A" = codex ]; then printf '%s' "$AID" > "$D/sessions/$SID/codex-thread"
    else printf '%s' "$AID" > "$D/sessions/$SID/claude-session"; fi
    exit 0 ;;
  stop)
    SID=${3:-}; valid_sid "$SID" || exit 2
    P=$D/sessions/$SID/pid
    if [ -f "$P" ]; then
      kill_tree "$(cat "$P")"
      rm -f "$P"
      jq -cn --arg s "$SID" '{type:"buddy_stopped",buddy_session:$s}' | post
    fi
    exit 0 ;;
  delete)
    SID=${3:-}; valid_sid "$SID" || exit 2
    S=$D/sessions/$SID
    [ -f "$S/pid" ] && kill_tree "$(cat "$S/pid")"
    rm -rf "${S:?}"
    exit 0 ;;
  ask) SID=${3:-}; BACKEND=${4:-claude}; DEV=${5:-0}; MSG=${6:-}; MODEL=${7:-}; FILES=${8:-}; EFFORT=${9:-}
    [[ "$EFFORT" =~ ^(low|medium|high|xhigh|max)$ ]] || EFFORT="" ;;
  *) echo "usage: buddy-run <token> ask|stop|delete|ping ..." >&2; exit 2 ;;
esac

valid_sid "$SID" || exit 2
[ -z "$MSG" ] && exit 0
S=$D/sessions/$SID
mkdir -p "$S"
event() { jq -cn --arg type "$1" --arg text "${2:-}" --arg s "$SID" '{type:$type,text:$text,buddy_session:$s}' | post; }
tag() { jq -c --arg s "$SID" '. + {buddy_session:$s}' 2>/dev/null; }

if [ -f "$S/pid" ] && kill -0 "$(cat "$S/pid")" 2>/dev/null; then
  event buddy_error "This session is still working. Tap Stop first, or start another session."
  exit 0
fi

# Attachments: fetch them from the app (comma-separated ids) into this session's files folder.
ATT=()
IMGS=()
if [ -n "${FILES:-}" ]; then
  mkdir -p "$S/files"
  IFS=, read -ra ids <<< "$FILES"
  for id in "${ids[@]}"; do
    [[ "$id" =~ ^[A-Za-z0-9._-]{1,120}$ && "$id" != *..* ]] || continue
    if curl -s -f -m 120 -H "Authorization: Bearer $TOKEN" "$URL/file/$id" -o "$S/files/$id"; then
      ATT+=("$S/files/$id")
      case "${id,,}" in *.jpg|*.jpeg|*.png|*.webp|*.gif) IMGS+=("$S/files/$id") ;; esac
    else
      event buddy_error "Couldn't get the attachment ${id#*_} from Buddy."
    fi
  done
  if [ ${#ATT[@]} -gt 0 ]; then
    MSG="$MSG

[The user attached $( [ ${#ATT[@]} -eq 1 ] && echo "a file" || echo "${#ATT[@]} files" ), saved on this phone. Open them with your Read tool (images show as pictures):
$(printf -- '- %s\n' "${ATT[@]}")]"
  fi
fi

SYSTEM=$(cat "$D/system-prompt.md" 2>/dev/null)
PERMS=$(cat "$D/permissions.md" 2>/dev/null)
[ -n "$PERMS" ] && SYSTEM="$SYSTEM

$PERMS"
# the background browser (Settings): its tools and when to use them, while it is on; never in a rule run
BROWSER=0
[ -e "$D/browser-on" ] && [ "$DEV" != rule ] && BROWSER=1
[ "$BROWSER" = 1 ] && SYSTEM="$SYSTEM

$(cat "$D/browser-prompt.md" 2>/dev/null)"
if [ "$DEV" = 1 ]; then
  SYSTEM="$SYSTEM

Linux tools are ON in this chat: you may run shell commands and create or edit files. Work inside $W (one folder per project).
Before building an Android app, read the android-app skill (Claude Code) or AGENTS.md (Codex, OpenCode, Antigravity, Grok) in $W and follow it."
elif [ "$DEV" = 0 ]; then
  SYSTEM="$SYSTEM

Linux tools are off in this chat: no shell commands or file edits. If the user asks for something that needs them
(building an app, running commands), tell them to turn on Linux tools with the chip under this chat's title, then ask again."
fi

# ---------------------------------------------------------------- Claude Code
run_claude() {
  local mcp tools
  mcp=$(jq -cn --arg url "$URL/mcp?chat=$SID" --arg auth "Bearer $TOKEN" \
    '{mcpServers:{phone:{type:"http",url:$url,headers:{Authorization:$auth},timeout:600000}}}')
  tools=("mcp__phone" "WebSearch" "WebFetch" "Read(/$S/files/**)" "Read(/$D/GUIDE.md)")
  [ "$DEV" = rule ] && tools=("mcp__phone")
  local deny=()
  [ "$DEV" = rule ] && deny=(--disallowedTools "Bash" "WebFetch" "WebSearch" "Write" "Edit" "NotebookEdit" "Skill")
  [ "$DEV" = 1 ] && tools+=("Bash" "Read" "Write" "Edit" "Glob" "Grep" "Skill")
  local args=(-p "$MSG" --output-format stream-json --verbose
    --mcp-config "$mcp" --strict-mcp-config
    --allowedTools "${tools[@]}" "${deny[@]}"
    --append-system-prompt "$SYSTEM")
  [ -s "$S/claude-session" ] && args+=(--resume "$(cat "$S/claude-session")")
  [ -n "${MODEL:-}" ] && args+=(--model "$MODEL")
  [ -n "${EFFORT:-}" ] && args+=(--effort "$EFFORT")
  cd "$W" && claude "${args[@]}" 2>"$S/last-error.log"
}

stream_claude() {
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    printf '%s' "$line" | tag | post
    sid=$(printf '%s' "$line" | jq -r 'select(.session_id != null) | .session_id' 2>/dev/null)
    [ -n "$sid" ] && printf '%s' "$sid" > "$S/claude-session"
  done
}

# ---------------------------------------------------------------------- Codex
# The phone server is passed with -c (no config file needed). Only the phone tools are
# pre-approved. Normal mode keeps Codex's shell read-only; developer mode opens all of Buddy's Linux to it.
run_codex() {
  local prompt=$MSG
  local cfg=(-c 'mcp_servers.phone.url="'"$URL"'/mcp?chat='"$SID"'"'
    -c 'mcp_servers.phone.bearer_token_env_var="BUDDY_TOKEN"'
    -c 'mcp_servers.phone.default_tools_approval_mode="approve"'
    -c 'mcp_servers.phone.tool_timeout_sec=600')
  local sandbox=(--sandbox read-only)
  # developer mode: the whole of Buddy's Linux, like Claude Code's Bash and OpenCode (so apk add works too)
  [ "$DEV" = 1 ] && sandbox=(--sandbox danger-full-access)
  [ -n "${MODEL:-}" ] && cfg+=(-m "$MODEL")
  [ -n "${EFFORT:-}" ] && cfg+=(-c "model_reasoning_effort=\"$EFFORT\"")
  local img=() f
  for f in "${IMGS[@]}"; do img+=("--image=$f"); done
  cd "$W" || return 1
  if [ -s "$S/codex-thread" ]; then
    BUDDY_TOKEN=$TOKEN codex exec "${cfg[@]}" "${sandbox[@]}" --json --skip-git-repo-check \
      resume "${img[@]}" -- "$(cat "$S/codex-thread")" "$prompt" </dev/null 2>"$S/last-error.log"
  else
    # codex exec has no system-prompt flag, so Buddy's instructions lead the first message.
    prompt="$SYSTEM"$'\n\n---\n\nUser message from the Buddy bubble:\n'"$MSG"
    BUDDY_TOKEN=$TOKEN codex exec "${cfg[@]}" "${sandbox[@]}" "${img[@]}" --json --skip-git-repo-check \
      -- "$prompt" </dev/null 2>"$S/last-error.log"
  fi
}

# Translate Codex's JSONL events into the Claude Code stream format the bubble understands.
stream_codex() {
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    tid=$(printf '%s' "$line" | jq -r 'select(.type=="thread.started") | .thread_id // empty' 2>/dev/null)
    [ -n "$tid" ] && printf '%s' "$tid" > "$S/codex-thread"
    # Codex doesn't say which model it used; its session log does (shown when the chat is on "Default")
    if [ "$(printf '%s' "$line" | jq -r '.type // empty' 2>/dev/null)" = turn.completed ] && [ -s "$S/codex-thread" ]; then
      local log model
      log=$(find "$HOME/.codex/sessions" -name "rollout-*$(cat "$S/codex-thread").jsonl" 2>/dev/null | head -1)
      model=$([ -n "$log" ] && grep '"turn_context"' "$log" | tail -1 | jq -r '.payload.model // empty' 2>/dev/null)
      [ -n "$model" ] && jq -cn --arg m "$model" --arg s "$SID" '{type:"system", subtype:"model", model:$m, buddy_session:$s}' | post
      # the plan's 5-hour and weekly limits, from the log's last token_count, passed on as Claude Code reports them
      [ -n "$log" ] && grep '"rate_limits"' "$log" | tail -1 | jq -c --arg s "$SID" '.payload.rate_limits // empty
        | [.primary, .secondary] | map(select(. != null and .window_minutes != null)
            | {key:(if .window_minutes <= 300 then "five_hour" else "seven_day" end),
               value:{utilization:((.used_percent // 0) / 100), resetsAt:(.resets_at // 0)}})
        | select(length > 0)
        | {type:"rate_limit_event", rate_limit_info:{unifiedWindows:from_entries}, buddy_session:$s}' 2>/dev/null | post
    fi
    printf '%s' "$line" | jq -c --arg s "$SID" '
      (if .type == "item.started" and .item.type == "mcp_tool_call" then
        {type:"assistant", message:{content:[{type:"tool_use",
          name:("mcp__" + (.item.server // "phone") + "__" + (.item.tool // "")),
          input:(.item.arguments // {})}]}}
      elif .type == "item.started" and .item.type == "command_execution" then
        {type:"assistant", message:{content:[{type:"tool_use", name:"Bash",
          input:{command:(.item.command // "")}}]}}
      elif .type == "item.completed" and .item.type == "file_change" then
        {type:"assistant", message:{content:[{type:"tool_use", name:"Edit", input:{}}]}}
      elif .type == "item.completed" and .item.type == "agent_message" then
        {type:"assistant", message:{content:[{type:"text", text:(.item.text // "")}]}}
      elif .type == "turn.completed" then
        {type:"result", subtype:"success", result:""}
      elif .type == "turn.failed" then
        {type:"result", subtype:"error", is_error:true, result:("Codex: " + (.error.message // "turn failed"))}
      elif .type == "error" then
        {type:"buddy_error", text:("Codex: " + (.message // "error"))}
      else empty end) | . + {buddy_session:$s}' 2>/dev/null | while IFS= read -r ev; do printf '%s' "$ev" | post; done
  done
}

# ------------------------------------------------------------------- OpenCode
# Config goes in through OPENCODE_CONFIG_CONTENT: the phone server, Buddy's instructions (a file), no
# auto-update or sharing. Normal mode sets shell and edits to "ask", which a non-interactive run
# auto-rejects ("deny" would drop those tools, and OpenCode's free models refuse a changed tool set).
run_opencode() {
  # OpenCode names MCP tools <server>_<tool>; small models otherwise call "read_screen" and give up
  printf '%s\n\n%s\n' "$SYSTEM" "In this app the phone tools are named with a phone_ prefix: phone_read_screen, phone_tap, \
phone_long_press, phone_type_text, phone_scroll, phone_swipe, phone_press, phone_open_app, phone_list_apps, phone_open_url, \
phone_screenshot, phone_wait, phone_confirm, phone_ask, phone_notify, phone_reply_notification, phone_schedule_message, phone_list_scheduled, phone_cancel_scheduled, phone_update_buddy, phone_install_apk and phone_wait_for_install\
$([ "$BROWSER" = 1 ] && printf '%s' ", and for the background browser phone_browser_open, phone_browser_read, phone_browser_click, \
phone_browser_type, phone_browser_scroll, phone_browser_screenshot, phone_browser_back and phone_browser_tabs"). Always call them by \
these exact names; they are available in every message of this chat." > "$S/system.md"
  local cfg v2=0
  oc2 && v2=1
  # OpenCode 2 ignores instructions given through OPENCODE_CONFIG_CONTENT (the model never saw this prompt),
  # but reads its global AGENTS.md, next to the work folder's own. Buddy owns that file (marked on line 1)
  # and leaves one the user wrote alone.
  if [ "$v2" = 1 ]; then
    local g=$HOME/.config/opencode/AGENTS.md
    if [ ! -s "$g" ] || head -1 "$g" | grep -q '^<!-- buddy -->'; then
      mkdir -p "${g%/*}" && { echo '<!-- buddy -->'; cat "$S/system.md"; } > "$g"
    fi
  fi
  # OpenCode 2 only takes codemode under mcp.servers; without it the phone tools hide behind one "execute" tool
  cfg=$(jq -cn --arg url "$URL/mcp?chat=$SID" --arg auth "Bearer $TOKEN" --arg sys "$S/system.md" --arg dev "$DEV" --arg v2 "$v2" '
    {type:"remote", url:$url, headers:{Authorization:$auth}, oauth:false} as $phone
    | (if $v2 == "1" then {mcp:{servers:{phone:($phone + {codemode:false, timeout:{execution:600000}})}}}
       else {mcp:{phone:($phone + {timeout:600000})}} end)
    + {instructions:[$sys], autoupdate:false, share:"disabled"}
    + (if $dev == "1" then {} elif $dev == "rule" then {permission:{bash:"ask", edit:"ask", webfetch:"ask"}}
       else {permission:{bash:"ask", edit:"ask"}} end)')
  local args=(run --format json)
  [ "$v2" = 1 ] && args+=(--standalone)
  [ -s "$S/opencode-session" ] && args+=(-s "$(cat "$S/opencode-session")")
  [ -n "${MODEL:-}" ] && args+=(-m "$MODEL")
  local f
  for f in "${ATT[@]}"; do args+=(-f "$f"); done
  cd "$W" && OPENCODE_CONFIG_CONTENT=$cfg opencode "${args[@]}" -- "$MSG" </dev/null 2>"$S/last-error.log"
}

# Translate OpenCode's JSON events into the Claude Code stream format the bubble understands.
# Only the text of the step that ends the turn (its answer) is shown: text written before tool calls is
# the model thinking out loud (free models even leak their reasoning, ending in </think>), and Buddy
# doesn't show Claude Code's or Codex's thinking either. Tool calls still show as steps.
stream_opencode() {
  local pending="" failed="" line sid typ t
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    sid=$(printf '%s' "$line" | jq -r '.sessionID // empty' 2>/dev/null)
    [ -n "$sid" ] && printf '%s' "$sid" > "$S/opencode-session"
    typ=$(printf '%s' "$line" | jq -r '.type // empty' 2>/dev/null)
    [ "$typ" = error ] && failed=1
    case "$typ" in
      step_start) pending="" ;;
      text)
        t=$(printf '%s' "$line" | jq -r '.part.text // "" | gsub("(?s)<think>.*?</think>"; "") | split("</think>") | last
          | sub("^\\s+"; "") | sub("\\s+$"; "")' 2>/dev/null)
        [ -n "$t" ] && pending="${pending:+$pending$'\n\n'}$t" ;;
      step_finish)
        if [ "$(printf '%s' "$line" | jq -r '.part.reason // empty' 2>/dev/null)" = stop ]; then
          [ -n "$pending" ] && jq -cn --arg t "$pending" --arg s "$SID" \
            '{type:"assistant", message:{content:[{type:"text", text:$t}]}, buddy_session:$s}' | post
          jq -cn --arg s "$SID" '{type:"result", subtype:"success", result:"", buddy_session:$s}' | post
        fi
        pending="" ;;
      tool_use|error)
        printf '%s' "$line" | jq -c --arg s "$SID" '
          (if .type == "tool_use" and .part.tool == "invalid" then empty   # a mistyped tool name; the model retries
          elif .type == "tool_use" and .part.tool == "execute" then empty  # OpenCode 2 code tool (the phone is not in it)
          elif .type == "tool_use" then
            (.part.tool // "") as $t
            | {type:"assistant", message:{content:[{type:"tool_use",
                name:(if ($t | startswith("phone_")) then "mcp__phone__" + ($t | ltrimstr("phone_"))
                      elif ($t == "bash" or $t == "shell") then "Bash" elif ($t == "edit" or $t == "write" or $t == "patch") then "Edit"
                      elif $t == "read" then "Read" else $t end),
                input:((.part.state.input // {}) + (if ($t == "phone_confirm" or $t == "phone_ask")
                  then {_answer:(.part.state.output // "")} else {} end))}]}}
          else
            {type:"result", subtype:"error", is_error:true,
             result:((.error.data.message // .error.message // .error.name // .error.type // "error") as $m
               | if ($m | test("free tier"; "i")) then "OpenCode free models turned this request down (they sometimes do when busy). Try again in a moment, or pick another model."
                 else "OpenCode: " + $m end)}
          end) | . + {buddy_session:$s}' 2>/dev/null | while IFS= read -r ev; do printf '%s' "$ev" | post; done ;;
    esac
  done
  # OpenCode 2 sometimes ends without the last step_finish: still show the answer
  if [ -n "$pending" ] && [ -z "$failed" ]; then
    jq -cn --arg t "$pending" --arg s "$SID" '{type:"assistant", message:{content:[{type:"text", text:$t}]}, buddy_session:$s}' | post
    jq -cn --arg s "$SID" '{type:"result", subtype:"success", result:"", buddy_session:$s}' | post
  fi
}

# ---------------------------------------------------------------- Antigravity
# agy reads MCP servers only from ~/.gemini/config/mcp_config.json and permissions from its settings.json, but each
# chat needs its own phone address (?chat=) and mode. So every run gets its own HOME: its own config and settings,
# with everything else (the sign-in, conversations) linked to the real ~/.gemini/antigravity-cli.
# Only the phone tools (and the chat's attachments) are pre-approved; developer mode skips agy's permission checks,
# like Codex's full access. timeoutSeconds: an approval card may wait for the user (10 minutes, as for the others).
AGY_PHONE_TOOLS='["read_screen","tap","long_press","type_text","scroll","swipe","press","open_app","list_apps","open_url",
"screenshot","wait","confirm","ask","notify","reply_notification","schedule_message","list_scheduled","cancel_scheduled",
"update_buddy","install_apk","wait_for_install","point_out"]'
run_agy() {
  local h=$S/agy-home g=$HOME/.gemini/antigravity-cli f list tools sigs
  mkdir -p "$h/.gemini/config" "$h/.gemini/antigravity-cli" "$g" "$HOME/.gemini/config"
  for f in "$g"/* "$g"/.[!.]*; do
    [ -e "$f" ] || continue
    case "${f##*/}" in settings.json|brain) continue ;; esac
    ln -sfn "$f" "$h/.gemini/antigravity-cli/${f##*/}"
  done
  # agy saves a long tool result (list_apps, …) under brain/<conversation>/ and has the model read it back, but it
  # only lets the model read inside its own folder, and a link out of it doesn't count: each chat keeps its own brain/
  [ -L "$h/.gemini/antigravity-cli/brain" ] && rm -f "$h/.gemini/antigravity-cli/brain"
  mkdir -p "$h/.gemini/antigravity-cli/brain"
  for f in "$HOME/.gemini/config"/*; do
    [ -e "$f" ] && [ "${f##*/}" != mcp_config.json ] && ln -sfn "$f" "$h/.gemini/config/${f##*/}"
  done
  ( umask 077
    jq -n --arg url "$URL/mcp?chat=$SID" --arg auth "Bearer $TOKEN" \
      '{mcpServers:{phone:{url:$url, headers:{Authorization:$auth}, timeoutSeconds:600}}}' > "$h/.gemini/config/mcp_config.json" )
  # the phone's tools as the server lists them (a newer Buddy may have more); the known list if that fails
  list=$(curl -s -m 10 -X POST -H "Authorization: Bearer $TOKEN" -H 'Content-Type: application/json' \
    -H 'Accept: application/json, text/event-stream' --data '{"jsonrpc":"2.0","id":1,"method":"tools/list"}' \
    "$URL/mcp?chat=$SID")
  tools=$(jq -c '[.result.tools[].name] | select(length > 0)' <<<"$list" 2>/dev/null)
  # and their arguments, "tap(element?, x?, y?)": agy itself only lists tool names, and reads a tool's description
  # file before using it (a model round trip each), or guesses the arguments
  sigs=$(jq -r '[.result.tools[] | (.inputSchema.required // []) as $req | "\(.name)(" + ((.inputSchema.properties // {})
    | keys_unsorted | map(. as $k | if ($req | index($k)) != null then $k else $k + "?" end) | join(", ")) + ")"]
    | join(", ")' <<<"$list" 2>/dev/null)
  jq -n --argjson t "${tools:-$AGY_PHONE_TOOLS}" --arg files "$S/files" --arg brain "$h/.gemini/antigravity-cli/brain" \
    '{permissions:{allow:([$t[] | "mcp(phone/\(.))"] + ["read_file(\($files))", "read_file(\($brain))"])}}' \
    > "$h/.gemini/antigravity-cli/settings.json"
  local prompt=$MSG args names note
  # agy has no system-prompt flag, so Buddy's instructions lead a new conversation's first message (as for Codex).
  # It also lists MCP tools only by file: say how to call the phone's, or it goes looking (e.g. with ls, which a
  # normal chat refuses, and then it stops).
  [ -n "$sigs" ] || sigs=$(jq -r 'join(", ")' <<<"$AGY_PHONE_TOOLS" 2>/dev/null)
  note="In this app the phone tools are on the MCP server named \"phone\". Call them right away with call_mcp_tool \
(ServerName \"phone\", the ToolName and its Arguments as listed here; ? marks an optional one): $sigs. You don't need \
to read their descriptions first; only if an argument is unclear, read_file \
$h/.gemini/antigravity-cli/mcp/phone/<tool>.json."
  [ "$DEV" = 1 ] || note="$note Shell commands are not available in this chat; don't try them."
  [ -s "$S/agy-conversation" ] || prompt="$SYSTEM"$'\n\n'"$note"$'\n\n---\n\nUser message from the Buddy bubble:\n'"$MSG"
  args=(-p "$prompt" --output-format stream-json)
  [ -s "$S/agy-conversation" ] && args+=(--conversation "$(cat "$S/agy-conversation")")
  [ -n "${MODEL:-}" ] && args+=(--model "$MODEL")
  [ -n "${EFFORT:-}" ] && args+=(--effort "$EFFORT")
  [ "$DEV" = 1 ] && args+=(--dangerously-skip-permissions)
  rm -f "$S/agy-error"
  cd "$W" && HOME=$h agy "${args[@]}" </dev/null 2>"$S/last-error.log"
  local status=$?
  # a token refresh that replaced the link with a file: keep the new token in the real folder
  f=$h/.gemini/antigravity-cli/antigravity-oauth-token
  [ -f "$f" ] && [ ! -L "$f" ] && mv -f "$f" "$g/antigravity-oauth-token" && ln -sfn "$g/antigravity-oauth-token" "$f"
  return $status
}

# Translate agy's stream-json events (init, step_update, result) into the Claude Code stream format.
# A step's text arrives in pieces (text_delta) and is shown once the step is done; a tool step shows once.
# agy ends its turn when a permission is refused (no one to ask), often without a word. Then, unless this is the
# last try ($1 = last), the result isn't shown and $S/agy-denied says what was refused, for one nudge.
stream_agy() {
  local line typ idx state ev t denied="" said=""
  declare -A text=() shown=()
  rm -f "$S/agy-denied"
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    typ=$(printf '%s' "$line" | jq -r '.event // empty' 2>/dev/null)
    case "$typ" in
      init)
        printf '%s' "$line" | jq -r '.conversation_id // .init.conversation_id // empty' 2>/dev/null > "$S/agy-conversation.new"
        if [ -s "$S/agy-conversation.new" ]; then mv "$S/agy-conversation.new" "$S/agy-conversation"; else rm -f "$S/agy-conversation.new"; fi ;;
      step_update)
        idx=$(printf '%s' "$line" | jq -r '.step_update.step_index // 0' 2>/dev/null)
        state=$(printf '%s' "$line" | jq -r '.step_update.state // empty' 2>/dev/null)
        case "$(printf '%s' "$line" | jq -r '.step_update.step_type // empty' 2>/dev/null)" in
          user_input) ;;
          agent_response)
            text[$idx]+=$(printf '%s' "$line" | jq -j '.step_update.text_delta // ""' 2>/dev/null; printf x)
            text[$idx]=${text[$idx]%x}
            if [ "$state" = DONE ] && [ -z "${shown[$idx]:-}" ]; then
              shown[$idx]=1
              t=$(printf '%s' "${text[$idx]}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
              [ -n "$t" ] && said=1
              [ -n "$t" ] && jq -cn --arg t "$t" --arg s "$SID" \
                '{type:"assistant", message:{content:[{type:"text", text:$t}]}, buddy_session:$s}' | post
            fi ;;
          *)
            # a tool step (step_type "tool"): its tool_info has the name and parameters; a phone tool comes as
            # call_mcp_tool with {ServerName, ToolName, Arguments}. Before agy first uses an MCP tool it reads the
            # tool's description file from its own folder (…/antigravity-cli/mcp/<server>/<tool>.json), and it reads a
            # long result back from …/antigravity-cli/brain/…/output.txt: neither is shown.
            if [ "$state" = ERROR ]; then
              # refused by its permissions (a shell command in a normal chat, …): say so under the step
              t=$(printf '%s' "$line" | jq -r '.step_update as $u | ($u.tool_info // {}) as $i
                | select(($i.error.message // "") | test("denied permission|permission check failed"; "i"))
                | ($i.parameters.CommandLine // $u.tool_name // $i.name // "?")' 2>/dev/null)
              if [ -n "$t" ]; then
                denied=$t
                jq -cn --arg t "Not allowed in this chat: $t" --arg s "$SID" '{type:"buddy_step", text:$t, buddy_session:$s}' | post
              fi
              continue
            fi
            [ -n "${shown[$idx]:-}" ] && continue
            ev=$(printf '%s' "$line" | jq -c --arg s "$SID" '
              .step_update as $u | ($u.tool_info // {}) as $i | ($i.parameters // {}) as $p
              | ($u.tool_name // $i.name // "") as $t
              | select($t != "")
              | select(([$t] | inside(["finish", "wait", "wait_5_seconds", "list_permissions", "ask_permission",
                  "ask_custom_permission"])) | not)
              | select(($t == "read_file" or $t == "view_file") and (($p.Path // "") | test("/antigravity-cli/(mcp|brain)/")) | not)
              | (($p.Arguments // {}) | if type == "string" then (fromjson? // {}) else . end) as $args
              | {type:"assistant", message:{content:[{type:"tool_use",
                  name:(if $t == "call_mcp_tool" then "mcp__" + ($p.ServerName // "phone") + "__" + ($p.ToolName // "")
                        elif $t == "run_command" or $t == "send_command_input" then "Bash"
                        elif ($t | test("^(write_to_file|replace_file_content|multi_replace_file_content|sed_file|notebook_edit)$")) then "Edit"
                        elif $t == "read_file" or $t == "view_file" then "Read" elif $t == "search_web" then "WebSearch"
                        elif $t == "read_url_content" then "WebFetch" else $t end),
                  input:(if $t == "call_mcp_tool" then (if ($args | type) == "object" then $args else {} end)
                         else ({command:($p.CommandLine // $p.Command // null),
                                file_path:($p.Path // $p.TargetFile // $p.AbsolutePath // $p.FilePath // null),
                                query:($p.Query // null), url:($p.Url // $p.URL // null)}
                               | with_entries(select(.value != null and (.value | type) == "string"))) end)}]},
                buddy_session:$s}' 2>/dev/null)
            [ -n "$ev" ] && { printf '%s' "$ev" | post; shown[$idx]=1; }
            ;;
        esac ;;
      result)
        if [ "$(printf '%s' "$line" | jq -r '.result.status // empty' 2>/dev/null)" = SUCCESS ]; then
          # a refused file read shows only here, in denied_actions (its step just ends without output)
          if [ -z "$denied" ]; then
            denied=$(printf '%s' "$line" | jq -r '[.result.denied_actions[]? | .display_name // .action] | unique | join(", ")' 2>/dev/null)
            [ -n "$denied" ] && jq -cn --arg t "Not allowed in this chat: $denied" --arg s "$SID" \
              '{type:"buddy_step", text:$t, buddy_session:$s}' | post
          fi
          if [ -n "$denied" ] && [ -z "$said" ]; then
            if [ "${1:-}" = last ]; then
              jq -cn --arg s "$SID" --arg d "$denied" '{type:"result", subtype:"error", is_error:true,
                result:("Antigravity stopped after this chat refused: " + $d), buddy_session:$s}' | post
            else
              printf '%s' "$denied" > "$S/agy-denied"
            fi
          else
            jq -cn --arg s "$SID" '{type:"result", subtype:"success", result:"", buddy_session:$s}' | post
          fi
        else
          printf '%s' "$line" | jq -r '.result.error // "the request failed"' 2>/dev/null > "$S/agy-error"
          jq -cn --arg s "$SID" --arg e "$(cat "$S/agy-error")" \
            '{type:"result", subtype:"error", is_error:true, result:("Antigravity: " + $e), buddy_session:$s}' | post
        fi ;;
    esac
  done
}

# ----------------------------------------------------------------------- Grok
# grok reads MCP servers from ~/.grok/config.toml (and Claude Code's ~/.claude.json), but each chat needs its own phone
# address (?chat=). So every run gets its own GROK_HOME: the user's config.toml without its MCP servers, plus the phone
# with a 10-minute tool timeout (an approval card may wait for the user), and everything else (the sign-in, sessions)
# linked to the real ~/.grok. A headless run refuses what isn't pre-approved: the phone tools are; normal mode offers
# only the web and (once the chat has attachments) file reads, a rule's run only the phone; developer mode approves
# everything, like Codex's full access.
# grok's bundled skills (docx, pptx, code-review, …), found once per grok version: a phone chat turns them off
grok_bundled_skills() {
  local v f
  v=$(grok --version 2>/dev/null | awk '{print $2}')
  f=$D/grok-bundled-skills-${v:-unknown}
  if [ ! -s "$f" ]; then
    rm -f "$D"/grok-bundled-skills-*
    (cd /tmp && GROK_CLAUDE_SKILLS_ENABLED=0 GROK_CURSOR_SKILLS_ENABLED=0 timeout 60 grok inspect 2>/dev/null) \
      | sed -n 's/^ *└ \([A-Za-z0-9._-]*\) .* bundled.*$/\1/p' > "$f.new"
    [ -s "$f.new" ] && mv -f "$f.new" "$f" || rm -f "$f.new"
  fi
  cat "$f" 2>/dev/null
}

run_grok() {
  local h=$S/grok-home g=$HOME/.grok f sigs note
  # sessions/ and logs/ must be links before grok first writes them, or a chat's would stay in its own home
  mkdir -p "$h" "$g/sessions" "$g/logs"
  for f in "$g"/* "$g"/.[!.]*; do
    [ -e "$f" ] || continue
    [ "${f##*/}" = config.toml ] || ln -sfn "$f" "$h/${f##*/}"
  done
  ( umask 077
    { awk -v lean="$([ "$DEV" = 1 ] || echo 1)" '/^\[/ { skip = /^\[mcp_servers[.\]]/ || (lean && /^\[(skills|compat[.]codex)\]/) }
        !skip && !/^disabled_mcp_servers/' "$g/config.toml" 2>/dev/null
      printf '\n[mcp_servers.phone]\nurl = "%s"\ntool_timeout_sec = 600\n\n[mcp_servers.phone.headers]\nAuthorization = "Bearer %s"\n' \
        "$URL/mcp?chat=$SID" "$TOKEN"
      if [ "$DEV" != 1 ]; then
        printf '\n[skills]\ndisabled = [%s]\n\n[compat.codex]\nskills = false\nhooks = false\n' \
          "$(grok_bundled_skills | sed 's/.*/"&"/' | paste -sd, -)"
      fi
    } > "$h/config.toml" )
  # the phone's tools with their arguments, "tap(element?, x?, y?)": grok otherwise looks each one up first (search_tool)
  sigs=$(curl -s -m 10 -X POST -H "Authorization: Bearer $TOKEN" -H 'Content-Type: application/json' \
    -H 'Accept: application/json, text/event-stream' --data '{"jsonrpc":"2.0","id":1,"method":"tools/list"}' \
    "$URL/mcp?chat=$SID" | jq -r '[.result.tools[] | (.inputSchema.required // []) as $req | "\(.name)(" + ((.inputSchema.properties // {})
    | keys_unsorted | map(. as $k | if ($req | index($k)) != null then $k else $k + "?" end) | join(", ")) + ")"]
    | join(", ")' 2>/dev/null)
  note="In this app the phone tools are on the MCP server named \"phone\". Call them right away with use_tool \
(tool_name \"phone__<tool>\", e.g. phone__read_screen, and tool_input with its arguments${sigs:+ as listed here; ? marks an \
optional one: $sigs}). You don't need search_tool for them."
  [ "$DEV" = 1 ] || note="$note Shell commands are not available in this chat; don't try them."
  # --rules adds Buddy's instructions to grok's own, on every run (as --append-system-prompt does for Claude Code)
  local args=(-p "$MSG" --output-format streaming-messages-json --rules "$SYSTEM"$'\n\n'"$note" --allow 'MCPTool(phone__*)')
  case "$DEV" in
    1) args+=(--always-approve) ;;
    rule) args+=(--tools use_tool --disable-web-search) ;;  # use_tool and search_tool: the phone only
    *) if [ -d "$S/files" ]; then args+=(--tools read_file,web_search,web_fetch); else args+=(--tools web_search,web_fetch); fi
       args+=(--allow WebFetch) ;;
  esac
  [ "$DEV" = 1 ] || args+=(--no-subagents --no-plan)
  [ -s "$S/grok-session" ] && args+=(-r "$(cat "$S/grok-session")")
  [ -n "${MODEL:-}" ] && args+=(-m "$MODEL")
  [ -n "${EFFORT:-}" ] && args+=(--effort "$EFFORT")
  local lean=()
  [ "$DEV" = 1 ] || lean=(GROK_MEMORY=0 GROK_CLAUDE_SKILLS_ENABLED=0 GROK_CURSOR_SKILLS_ENABLED=0 GROK_CLAUDE_RULES_ENABLED=0
    GROK_CURSOR_RULES_ENABLED=0 GROK_CLAUDE_AGENTS_ENABLED=0 GROK_CURSOR_AGENTS_ENABLED=0 GROK_CLAUDE_HOOKS_ENABLED=0
    GROK_CURSOR_HOOKS_ENABLED=0)
  cd "$W" && env "${lean[@]}" GROK_HOME=$h GROK_CLAUDE_MCPS_ENABLED=0 GROK_CURSOR_MCPS_ENABLED=0 GROK_DISABLE_AUTOUPDATER=1 \
    grok "${args[@]}" </dev/null 2>"$S/last-error.log"
  local status=$?
  # a token refresh that replaced the link with a file: keep the new login in the real folder
  f=$h/auth.json
  [ -f "$f" ] && [ ! -L "$f" ] && mv -f "$f" "$g/auth.json" && ln -sfn "$g/auth.json" "$f"
  return $status
}

# grok's streaming-messages-json is Claude Code's stream format; only the tool names differ. A phone tool comes as
# use_tool {tool_name:"phone__tap", tool_input}; its lookups (search_tool) and its thinking aren't shown. A step the
# run refused (headless grok can't ask) is only on stderr ("permission required: … was not run"): said under the steps.
stream_grok() {
  local line typ sid t=""
  rm -f "$S/grok-error"
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    typ=$(printf '%s' "$line" | jq -r '.type // empty' 2>/dev/null)
    case "$typ" in
      system)
        sid=$(printf '%s' "$line" | jq -r '.session_id // empty' 2>/dev/null)
        [ -n "$sid" ] && printf '%s' "$sid" > "$S/grok-session" ;;
      result)
        t=$(sed -n 's/^permission required: \(.*\) was not run.*/\1/p' "$S/last-error.log" 2>/dev/null | sort -u | paste -sd, - | sed 's/,/, /g')
        [ -n "$t" ] && jq -cn --arg t "Not allowed in this chat: $t" --arg s "$SID" '{type:"buddy_step", text:$t, buddy_session:$s}' | post
        printf '%s' "$line" | jq -r 'select(.is_error) | (.errors // []) | join("; ") | if . == "" then "the request failed" else . end' \
          2>/dev/null > "$S/grok-error" ;;
    esac
    printf '%s' "$line" | jq -c --arg s "$SID" --arg denied "$t" '
      (if .type == "system" then {type, subtype, session_id, model}
      elif .type == "assistant" then
        .message.content |= [.[] | select(.type == "text" or (.type == "tool_use" and .name != "search_tool"))
          | if .type == "text" then . else
              (.input // {}) as $in | .name as $t
              | if $t == "use_tool" then
                  {type, name:("mcp__" + ($in.tool_name // "")),
                   input:(($in.tool_input // {}) | if type == "string" then (fromjson? // {}) else . end)}
                elif ($t | test("^[A-Za-z_][A-Za-z0-9_-]*__")) then {type, name:("mcp__" + $t), input:$in}
                elif $t == "run_terminal_command" or $t == "run_terminal_cmd" then {type, name:"Bash", input:{command:($in.command // "")}}
                elif $t == "write" or $t == "search_replace" then {type, name:"Edit", input:{file_path:($in.file_path // $in.target_file // "")}}
                elif $t == "read_file" then {type, name:"Read", input:{file_path:($in.target_file // $in.file_path // $in.path // "")}}
                elif $t == "web_search" then {type, name:"WebSearch", input:{query:($in.query // "")}}
                elif $t == "web_fetch" then {type, name:"WebFetch", input:{url:($in.url // "")}}
                else {type, name:$t, input:$in} end
            end]
        | select(.message.content | length > 0) | {type, message:{content:.message.content}}
      elif .type == "result" and .is_error then
        {type, subtype, is_error, result:(if $denied != "" and .errors == ["cancelled"] then "Grok stopped after this chat refused: " + $denied
          else "Grok: " + ((.errors // []) | join("; ") | if . == "" then "the request failed" else . end) end)}
      elif .type == "result" then {type, subtype, result:(.result // "")}
      elif .type == "error" then {type:"result", subtype:"error", is_error:true, result:("Grok: " + (.message // "error"))}
      else empty end) | . + {buddy_session:$s}' 2>/dev/null | while IFS= read -r ev; do printf '%s' "$ev" | post; done
  done
}

# Tests (linux/test/run.sh): translate an agent's recorded output from stdin with its stream_ function and print the
# events instead of posting them.
if [ -n "${BUDDY_TEST_STREAM:-}" ]; then
  post() { cat; echo; }
  "stream_$BUDDY_TEST_STREAM"
  exit 0
fi

# ------------------------------------------------------------------------ run
(
  if [ "$BACKEND" = opencode ]; then
    if ! have opencode; then event buddy_error "OpenCode isn't installed yet. Install it in Buddy's Settings."; exit 0; fi
    run_opencode | stream_opencode
    status=${PIPESTATUS[0]}
    if [ "$status" -ne 0 ] && [ -s "$S/opencode-session" ] && grep -q -i -E 'not found|no such|session' "$S/last-error.log" 2>/dev/null; then
      rm -f "$S/opencode-session"   # old session is gone; retry as a new conversation
      run_opencode | stream_opencode
      status=${PIPESTATUS[0]}
    fi
    name=OpenCode
  elif [ "$BACKEND" = agy ]; then
    if ! have agy; then event buddy_error "Antigravity isn't installed yet. Install it in Buddy's Settings."; exit 0; fi
    # a rule's run must get no shell, files or web; agy's allow list can't promise that yet (see Account.runsRules)
    if [ "$DEV" = rule ]; then event buddy_error "Antigravity can't run notification rules yet. Pick another agent for this rule."; exit 0; fi
    # the last run's raw events stay in the session folder, for checking how agy reports its steps
    run_agy | tee "$S/agy-last.jsonl" | stream_agy
    status=${PIPESTATUS[0]}
    # a refusal ended its turn without a word: nudge it on once, in the same conversation
    if [ -s "$S/agy-denied" ] && [ -s "$S/agy-conversation" ]; then
      MSG="(From Buddy, not the user) This chat doesn't allow that: $(cat "$S/agy-denied"). Carry on with the phone \
tools (call_mcp_tool, ServerName \"phone\") and finish the user's request."
      run_agy | tee -a "$S/agy-last.jsonl" | stream_agy last
      status=${PIPESTATUS[0]}
    fi
    if [ -s "$S/agy-conversation" ] && grep -q -i -E 'conversation.*(not found|no such|unknown)' "$S/agy-error" "$S/last-error.log" 2>/dev/null; then
      rm -f "$S/agy-conversation"   # old conversation is gone; retry as a new one
      run_agy | stream_agy
      status=${PIPESTATUS[0]}
    fi
    # a failed turn (quota reached, …) is already in the chat from its result; agy also exits non-zero and prints
    # the same error with raw JSON, which would show it twice
    [ -s "$S/agy-error" ] && status=0
    name=Antigravity
  elif [ "$BACKEND" = grok ]; then
    if ! have grok; then event buddy_error "Grok isn't installed yet. Install it in Buddy's Settings."; exit 0; fi
    run_grok | stream_grok
    status=${PIPESTATUS[0]}
    if [ "$status" -ne 0 ] && [ -s "$S/grok-session" ] && grep -q -i -E 'session.*not found|failed to restore session' "$S/last-error.log" 2>/dev/null; then
      rm -f "$S/grok-session"   # old session is gone; retry as a new conversation
      run_grok | stream_grok
      status=${PIPESTATUS[0]}
    fi
    # a failed turn (not signed in, …) is already in the chat from its result; grok also exits non-zero and prints
    # the same error, which would show it twice
    [ -s "$S/grok-error" ] && status=0
    name=Grok
  elif [ "$BACKEND" = codex ]; then
    if ! have codex; then event buddy_error "Codex isn't installed yet. Install it in Buddy's Settings."; exit 0; fi
    run_codex | stream_codex
    status=${PIPESTATUS[0]}
    if [ "$status" -ne 0 ] && [ -s "$S/codex-thread" ] && grep -q -i -E 'not found|no such|unknown (thread|session)' "$S/last-error.log" 2>/dev/null; then
      rm -f "$S/codex-thread"   # old thread is gone; retry as a new conversation
      run_codex | stream_codex
      status=${PIPESTATUS[0]}
    fi
    name=Codex
  else
    if ! have claude; then event buddy_error "Claude Code isn't installed yet. Install it in Buddy's Settings."; exit 0; fi
    run_claude | stream_claude
    status=${PIPESTATUS[0]}
    if [ "$status" -ne 0 ] && grep -q -i 'no conversation found' "$S/last-error.log" 2>/dev/null; then
      rm -f "$S/claude-session"   # old session is gone; retry as a new conversation
      run_claude | stream_claude
      status=${PIPESTATUS[0]}
    fi
    name="Claude Code"
  fi
  if [ "$status" -ne 0 ] && [ "$status" -ne 143 ] && [ -s "$S/last-error.log" ]; then
    event buddy_error "$name failed: $(tail -c 400 "$S/last-error.log")"
  fi
) &
echo $! > "$S/pid"
wait $! 2>/dev/null
rm -f "$S/pid"
event buddy_done
