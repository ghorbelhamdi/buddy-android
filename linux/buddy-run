#!/bin/bash
# Run by the Buddy app inside its built-in Linux (Alpine, through proot).
#   buddy-run <token> ask <session> <claude|codex|opencode|agy|grok|copilot|pi> <dev:0|1|rule|play> <message> [model] [attachment-ids]
#             [effort] [fresh] [lite] [folder]
#     (folder: the chat's project folder, a path inside the workspace; none = the workspace itself)
#     (rule: a notification rule's run, working for someone else's message: no shell, files or web tools;
#      play: the Play version, which has no Linux tools at all)
#                                    run the agent on the message in that session, streaming events to the bubble
#   buddy-run <token> stop <session>       stop that session's running request
#   buddy-run <token> reap <session>       end what is left of a run whose helper died, without a word to the chat
#   buddy-run <token> delete <session>     forget that session
#   buddy-run <token> prune <id,id,...>    remove the folders of chats not in the list
#   buddy-run <token> ping                 answer the app's setup check
#   buddy-run <token> procs                list running Claude Code / Codex / OpenCode / Antigravity / Grok / Copilot / Pi processes (buddy_procs)
#   buddy-run <token> kill <pid>           stop a running Claude Code / Codex process and its children
#   buddy-run <token> cmdprocs <session>   the processes under that chat's agent, on stdout ("agent <pid>", then ps rows)
#   buddy-run <token> cmdkill <session> <pid>   stop one of them and what it started (never the agent itself)
#   buddy-run <token> recent               list recent Claude Code / Codex sessions from their history (buddy_recent)
#   buddy-run <token> transcript <claude|codex> <file>   last messages of a session (buddy_transcript)
#   buddy-run <token> adopt <session> <claude|codex> <agent-session-id>  continue that session as a Buddy chat
# Every event sent to the bubble carries "buddy_session" so the app can route it.
HELPER_VERSION=40
set -u
export PATH=$HOME/.local/bin:$HOME/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# The claude launcher sets BUN_OPTIONS with a path relative to its folder; never inherit a stale one.
unset BUN_OPTIONS
D=$HOME/.buddy
W=$D/work
mkdir -p "$W" "$D/sessions"
TOKEN=${1:-}
CMD=${2:-}
URL=http://127.0.0.1:8765

post() { # post one JSON event to the bubble
  curl -s -m 5 -o /dev/null -X POST -H "Authorization: Bearer $TOKEN" \
    -H 'Content-Type: application/json' --data-binary @- "$URL/event"
}
# Tests (linux/test/run.sh, the runs): events go to a file instead of the app.
[ -n "${BUDDY_TEST_EVENTS:-}" ] && post() { cat >> "$BUDDY_TEST_EVENTS"; echo >> "$BUDDY_TEST_EVENTS"; }
have() { command -v "$1" >/dev/null 2>&1; }
valid_sid() { [[ "$1" =~ ^[A-Za-z0-9_-]{1,64}$ ]]; }
# OpenCode 2 (npm @opencode/cli) rather than 1.x (opencode-ai)? 2 needs --standalone, or it leaves a background service
oc2() { [[ "$(readlink -f "$(command -v opencode)" 2>/dev/null)" == */@opencode/cli/* ]]; }
# Copilot as Buddy installs it (see run_copilot); npm's own copilot command doesn't run here
COPILOT=$HOME/.local/bin/copilot
# Signed in = its own saved login (plaintext in ~/.copilot/config.json, as Buddy's Linux has no keychain), or the
# GitHub CLI's, which it uses too (Settings > GitHub)
copilot_signed() {
  sed '/^ *\/\//d' "$HOME/.copilot/config.json" 2>/dev/null | jq -e '(.authTokens // {}) | length > 0' >/dev/null 2>&1 \
    || grep -qs 'oauth_token:' "$HOME/.config/gh/hosts.yml"
}
# The model ids from `copilot help config` (on stdin), one a line: the "- \"id\"" lines under its `model` setting
copilot_models() {
  sed -n '/^ *`model`:/,/^$/p' | sed -n 's/^ *- "\([A-Za-z0-9._-]*\)"$/\1/p'
}
# Pi works once a provider is connected: a login or key in its auth.json (`/login`), or a provider of the user's own
# in its models.json
pi_signed() {
  jq -e 'length > 0' "$HOME/.pi/agent/auth.json" >/dev/null 2>&1 \
    || jq -e '(.providers // {}) | length > 0' "$HOME/.pi/agent/models.json" >/dev/null 2>&1
}
# Or, with no provider of its own, on a service saved in Buddy (Settings, Agents and models): any of them but the
# models on this phone, which are OpenCode's
pi_service() {
  local f
  for f in "$D"/providers/*.json; do
    [ -s "$f" ] && [ "${f##*/}" != onphone.json ] && return 0
  done
  return 1
}
# The model list from `pi --list-models` (on stdin), "provider/model" a line
pi_models() {
  awk 'NR > 1 && NF >= 2 && $1 != "provider" { print $1 "/" $2 }'
}

# A sign-in an agent refreshed during a run (its link in the chat's folder became a file with the new token) goes back
# to the real folder: at the run's end, or here before the links are made again when a Stop ended that run first. Only
# when it's newer than the real one, which a sign-in made since then would be.
keep_login() {
  [ -f "$1" ] && [ ! -L "$1" ] || return 0
  if [ "$1" -nt "$2" ] || [ ! -e "$2" ]; then mv -f "$1" "$2"; else rm -f "$1"; fi
}

# Kill a process and everything it started (claude/codex run a few levels below buddy-run).
kill_tree() {
  local p=$1 c
  for c in $(pgrep -P "$p" 2>/dev/null); do kill_tree "$c"; done
  kill -TERM "$p" 2>/dev/null
}

# A process and everything under it, deepest first.
tree() {
  local c
  for c in $(pgrep -P "$1" 2>/dev/null); do tree "$c"; done
  echo "$1"
}

# Ends a run for good: asks its processes to stop, then, a few seconds on, kills the ones still there. A run whose
# proot was killed under it (Android ending an app's processes) is left without the tracer its system calls go
# through: its shell then spins at full CPU, waiting on a child it can never collect, and never says it is done
# (issue #53). Nothing short of a kill ends that.
end_run() {
  local all p
  all=$(tree "$1")
  kill -TERM $all 2>/dev/null
  local left t
  for t in 1 2 3 4 5; do
    # (kill -0 on all of them fails as soon as one is gone: each is looked at on its own)
    left=""
    for p in $all; do kill -0 "$p" 2>/dev/null && left="$left $p"; done
    [ -z "$left" ] && return 0
    sleep 1
  done
  kill -KILL $left 2>/dev/null
  return 0
}

# An agent's run (run_<agent>), then a line saying it has ended. Something the agent started (an MCP server, a job in
# the background) can keep its output open after it is gone; read to the end, the stream waited for that too, and the
# chat stayed "working" with no buddy_done. Every stream_<agent> stops at this line. The agent keeps the input it had.
AGENT_END="buddy-run: the agent has ended $$"
ended() {
  local s
  "$@" <&0 &
  wait "$!"; s=$?
  printf '\n%s\n' "$AGENT_END"
  return "$s"
}

descendants() { # print a pid and all its descendants
  local p=$1 c
  echo "$p"
  for c in $(pgrep -P "$p" 2>/dev/null); do descendants "$c"; done
}


# Is this pid an agent process (the real claude / codex / opencode / agy / grok / copilot / pi program)?
agent_of() {
  local cmd arg
  cmd=$(tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null) || return 1
  # Copilot runs on Node (see buddy-copilot): node …/copilot/pkg/<platform>/<version>/index.js. So does Pi, which then
  # names its process "pi" (below).
  arg=${cmd#* }; arg=${arg%% *}
  case "${cmd%% *} $arg" in
    *node\ */copilot/pkg/*/index.js) echo copilot; return 0 ;;
    *node\ */bin/pi|*node\ */pi-coding-agent/dist/*) echo pi; return 0 ;;
  esac
  case "${cmd%% *}" in
    */claude/versions/*) echo claude ;;
    */codex-linux-*/*|*/bin/codex) echo codex ;;
    */opencode-ai/*|*/@opencode/cli*/*|*/bin/opencode) echo opencode ;;
    */antigravity-cli/bin/*|*/bin/agy) echo agy ;;
    grok|*/bin/grok|*/grok-linux-*) echo grok ;;
    pi) echo pi ;;
    # started by name, as buddy-run starts them: Claude Code's argv[0] is then just "claude"
    claude|codex|opencode|agy) echo "${cmd%% *}" ;;
    *) return 1 ;;
  esac
}

# A process and everything under it, parents first, as "pid depth" lines, from one listing of every process ($PS,
# from ps -e -o pid=,ppid=,...): the chat's "what is it doing" sheet asks every 2 s, and a pgrep per process is slow
# under proot.
subtree() {
  printf '%s\n' "$PS" | awk -v r="$1" '{ kids[$2] = kids[$2] " " $1 }
    function walk(p, d,   n, a, i) { print p, d; n = split(kids[p], a, " "); for (i = 1; i <= n; i++) walk(a[i], d + 1) }
    END { walk(r, 0) }'
}

# The chat's agent program (claude, codex…) in its running request, or nothing: the first one under the run.
chat_agent() {
  local r p
  r=$(cat "$D/sessions/$1/pid" 2>/dev/null)
  [[ "$r" =~ ^[0-9]+$ ]] || return 1
  for p in $(subtree "$r" | cut -d' ' -f1); do
    agent_of "$p" >/dev/null && { echo "$p"; return 0; }
  done
  return 1
}

case "$CMD" in
  ping) # setup check: proves RUN_COMMAND, the helper and the callback all work
    agents=$({ have claude && echo claude; have codex && echo codex; have opencode && echo opencode; have agy && echo agy
      have grok && echo grok; [ -x "$COPILOT" ] && echo copilot; have pi && echo pi; } | paste -sd, -)
    # signed in = the agent's saved login exists (OpenCode works without one: its free models)
    # (or Claude Code's API key in its settings' env; Codex keeps an API key in auth.json too)
    # (or a service saved in Buddy that the agent can use: $D/providers, without the keys)
    signed=$({ { [ -s "$HOME/.claude/.credentials.json" ] || grep -qs '"anthropic":true' "$D"/providers/*.json; } && echo claude
      { [ -s "$HOME/.codex/auth.json" ] || grep -qs '"openai":"responses"' "$D"/providers/*.json; } && echo codex
      have opencode && echo opencode; [ -s "$HOME/.gemini/antigravity-cli/antigravity-oauth-token" ] && echo agy
      [ -s "$HOME/.grok/auth.json" ] && echo grok; [ -x "$COPILOT" ] && copilot_signed && echo copilot
      have pi && { pi_signed || pi_service; } && echo pi; } | paste -sd, -)
    # Claude Code's own model list (what its /model shows), asked from Claude Code itself over its control protocol:
    # about 3 s, sends no message. Rows [id, name, effort levels]; the "default" row tells which model its default is.
    # On failure the last good list is kept.
    if have claude; then
      printf '%s\n' '{"type":"control_request","request_id":"buddy","request":{"subtype":"initialize"}}' \
        | (cd "$D" && timeout 60 claude -p --input-format stream-json --output-format stream-json --verbose 2>/dev/null) \
        | jq -c 'select(.type == "control_response") | [.response.response.models[]?] as $m
            | {d: ([$m[] | select(.value == "default") | .resolvedModel // ""][0] // ""),
               l: (reduce ($m[] | select(.value != "default")) as $x ([];
                    ($x.resolvedModel // $x.value) as $id
                    | if any(.[]; .[0] == $id) then . else . + [[$id, ($x.displayName // $id), (($x.supportedEffortLevels // []) | join(","))]] end))}
            | select(.l | length > 0)' 2>/dev/null | head -n 1 >"$D/claude-models.new"
      [ -s "$D/claude-models.new" ] && mv "$D/claude-models.new" "$D/claude-models"
    fi
    lm=$(jq -c '.l' "$D/claude-models" 2>/dev/null)
    ld=$(jq -r '.d' "$D/claude-models" 2>/dev/null)
    cm=$(jq -c '[.models[] | select(.visibility == "list") | [.slug, .display_name, ([.supported_reasoning_levels[]?.effort] | join(","))]]' "$HOME/.codex/models_cache.json" 2>/dev/null)
    # OpenCode's model list (a second or two; a background refresh got killed when the helper exited, so the list
    # never updated and new free models didn't show). On failure the last good list is kept.
    have opencode && timeout 30 opencode models $(oc2 && echo --standalone) >"$D/opencode-models.new" 2>/dev/null \
      && [ -s "$D/opencode-models.new" ] && mv "$D/opencode-models.new" "$D/opencode-models"
    # Antigravity's models ("id<TAB>name" lines; the list depends on the account's plan)
    if have agy && [ -s "$HOME/.gemini/antigravity-cli/antigravity-oauth-token" ]; then
      timeout 30 agy models >"$D/agy-models.new" 2>/dev/null && grep -q "$(printf '\t')" "$D/agy-models.new" \
        && mv "$D/agy-models.new" "$D/agy-models"
    fi
    am=$(jq -Rsc 'split("\n") | map(select(test("^[A-Za-z0-9._-]+\t.")) | split("\t") | [.[0], .[1]])' "$D/agy-models" 2>/dev/null)
    # Grok's ("  * grok-4.7 (default)" lines; its ids are its names)
    if have grok && [ -s "$HOME/.grok/auth.json" ]; then
      timeout 30 grok models >"$D/grok-models.new" 2>/dev/null && grep -q '^ *[*-] ' "$D/grok-models.new" \
        && mv "$D/grok-models.new" "$D/grok-models"
    fi
    gm=$(jq -Rsc 'split("\n") | map(capture("^\\s*[*-]\\s+(?<id>[A-Za-z0-9._-]+)") | [.id, .id])' "$D/grok-models" 2>/dev/null)
    om=$(jq -Rsc 'split("\n") | map(select(test("^[A-Za-z0-9._-]+/\\S+$"))) | map([., (split("/") | .[1:] | join("/"))])' "$D/opencode-models" 2>/dev/null)
    # Copilot's: the model ids its settings accept (`copilot help config`), the same for every plan; a model the
    # plan doesn't have fails with Copilot's own message
    if [ -x "$COPILOT" ]; then
      timeout 30 "$COPILOT" help config 2>/dev/null | copilot_models >"$D/copilot-models.new" && [ -s "$D/copilot-models.new" ] \
        && mv "$D/copilot-models.new" "$D/copilot-models"
    fi
    pm=$(jq -Rsc 'split("\n") | map(select(length > 0) | [., .])' "$D/copilot-models" 2>/dev/null)
    # Pi's: the models of the providers connected (`pi --list-models`: "provider  model  context …" rows)
    if have pi && pi_signed; then
      PI_SKIP_VERSION_CHECK=1 timeout 30 pi --list-models 2>/dev/null | pi_models >"$D/pi-models.new" && [ -s "$D/pi-models.new" ] \
        && mv "$D/pi-models.new" "$D/pi-models"
    fi
    im=$(jq -Rsc 'split("\n") | map(select(test("^[^/ ]+/\\S+$")) | [., (split("/") | .[1:] | join("/"))])' "$D/pi-models" 2>/dev/null)
    jq -cn --arg s "${agents:-none}" --arg g "${signed:-none}" --argjson v "$HELPER_VERSION" --argjson cm "${cm:-[]}" \
      --argjson om "${om:-[]}" --argjson am "${am:-[]}" --argjson gm "${gm:-[]}" --argjson pm "${pm:-[]}" --argjson im "${im:-[]}" --argjson lm "${lm:-[]}" --arg ld "${ld:-}" \
      '{type:"buddy_pong",text:$s,signed:$g,helper:$v,claude_models:$lm,claude_default:$ld,codex_models:$cm,opencode_models:$om,agy_models:$am,grok_models:$gm,copilot_models:$pm,pi_models:$im}' | post
    exit 0 ;;
  procs)
    # map every process started by a Buddy chat to that chat
    declare -A owner=()
    for f in "$D"/sessions/*/pid; do
      [ -f "$f" ] || continue
      sid=$(basename "$(dirname "$f")")
      for q in $(descendants "$(cat "$f")"); do owner[$q]=$sid; done
    done
    {
      for p in $(pgrep -f '^claude( |$)|^codex( |$)|^opencode( |$)|^agy( |$)|claude/versions/|codex-linux-|/bin/codex|opencode-ai/|@opencode/cli|/bin/opencode|antigravity-cli/bin/|/bin/agy|^grok( |$)|/bin/grok|grok-linux-|/copilot/pkg/|^pi( |$)|/bin/pi( |$)|pi-coding-agent/' 2>/dev/null); do
        a=$(agent_of "$p") || continue
        [ "$p" = "$$" ] && continue
        cwd=$(readlink "/proc/$p/cwd" 2>/dev/null)
        et=$(ps -o etimes= -p "$p" 2>/dev/null | tr -d ' ')
        args=$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | cut -c1-300)
        # what kind of process: Claude Code's background service, a session it hosts, or a terminal session
        pargs=$(tr '\0' ' ' < "/proc/$(ps -o ppid= -p "$p" | tr -d ' ')/cmdline" 2>/dev/null)
        kind=terminal
        case "$args" in *" daemon run"*) kind=daemon ;; esac
        [ "$kind" = terminal ] && case "$pargs" in *bg-pty-host*) kind=background ;; esac
        # its conversation: --session-id wins (a fork gets a new id), else --resume <id>
        ses=$(printf '%s' "$args" | grep -oE -- '--session-id [0-9a-f-]{36}' | head -1 | cut -d' ' -f2)
        [ -z "$ses" ] && ses=$(printf '%s' "$args" | grep -oE -- '--resume [0-9a-f-]{36}' | head -1 | cut -d' ' -f2)
        title=""
        if [ -n "$ses" ] && [ "$a" = claude ]; then
          f=$(ls "$HOME"/.claude/projects/*/"$ses".jsonl 2>/dev/null | head -1)
          [ -n "$f" ] && title=$(head -n 400 "$f" | jq -r 'select(.type=="user") | .message.content
            | if type=="string" then . else ([.[]? | select(.type=="text") | .text] | join(" ")) end
            | select(. != "" and (startswith("<") | not) and (startswith("This session is being continued") | not)
                and (startswith("Caveat:") | not))' 2>/dev/null | head -1 | tr '\n' ' ' | cut -c1-80)
        fi
        jq -cn --argjson pid "$p" --arg agent "$a" --arg cwd "$cwd" --arg et "${et:-0}" \
          --arg args "$args" --arg buddy "${owner[$p]:-}" --arg kind "$kind" --arg ses "$ses" --arg title "$title" \
          '{pid:$pid, agent:$agent, cwd:$cwd, seconds:($et|tonumber), args:$args, buddy:$buddy,
            kind:$kind, session:$ses, title:$title}'
      done
    } | jq -cs '{type:"buddy_procs", procs:.}' | post
    exit 0 ;;
  kill)
    P=${3:-}
    [[ "$P" =~ ^[0-9]+$ ]] && agent_of "$P" >/dev/null || exit 2   # only ever kill claude/codex/opencode/agy/grok/copilot/pi
    kill_tree "$P"
    exit 0 ;;
  cmdprocs)
    # what a chat's agent has running (the command it runs, what that started, its MCP servers), for the chat's sheet
    SID=${3:-}; valid_sid "$SID" || exit 2
    PS=$(ps -e -o pid=,ppid=,etimes=,times=,args= 2>/dev/null)
    A=$(chat_agent "$SID") || exit 0
    echo "agent $A"
    keep=" $(subtree "$A" | cut -d' ' -f1 | paste -sd' ' -) "
    printf '%s\n' "$PS" | awk -v keep="$keep" 'index(keep, " " $1 " ") { print substr($0, 1, 2000) }'
    exit 0 ;;
  cmdkill)
    # only ever something under that chat's agent, never the agent itself (that's Stop's job: the run ends with it)
    SID=${3:-}; P=${4:-}
    valid_sid "$SID" && [[ "$P" =~ ^[0-9]+$ ]] || exit 2
    PS=$(ps -e -o pid=,ppid=,etimes=,times=,args= 2>/dev/null)
    A=$(chat_agent "$SID") || { echo "This chat's agent isn't running."; exit 3; }
    if [ "$P" = "$A" ] || ! subtree "$A" | cut -d' ' -f1 | grep -qx "$P"; then
      echo "That process isn't one this chat's agent started, or it has ended."; exit 3
    fi
    # nor a part of the agent itself (OpenCode 2's engine and the terminal service it runs commands in): Stop ends those
    if tr '\0' ' ' < "/proc/$P/cmdline" 2>/dev/null | grep -qE '(^|/)opencode(\.exe)? serve( |$)|(^|/)opencode-pty daemon( |$)'; then
      echo "That is part of the agent itself: Stop ends it with the run."; exit 3
    fi
    end_run "$P"
    exit 0 ;;
  recent)
    {
      # skip the Remote Control session's folder (RemoteSession.DIR): it must not be adopted while it runs
      for f in $(ls -t "$HOME"/.claude/projects/*/*.jsonl 2>/dev/null | grep -v '/-root-remote/' | head -15); do
        head -n 300 "$f" | jq -c --arg f "$f" --arg m "$(stat -c %Y "$f")" -s '
          ([.[] | select(.type=="user") | .message.content
                | if type=="string" then . else ([.[]? | select(.type=="text") | .text] | join(" ")) end
                | select(. != "" and (startswith("<")|not) and (startswith("This session is being continued")|not)
                    and (startswith("Caveat:")|not))] | first // "") as $t
          | {agent:"claude", file:$f, id:($f|split("/")|last|rtrimstr(".jsonl")),
             cwd:([.[]|.cwd//empty]|first//""), title:($t|.[0:120]), mtime:($m|tonumber)}' 2>/dev/null
      done
      for f in $(find "$HOME/.codex/sessions" -name '*.jsonl' 2>/dev/null | xargs -r ls -t 2>/dev/null | head -15); do
        head -n 80 "$f" | jq -c --arg f "$f" --arg m "$(stat -c %Y "$f")" -s '
          ([.[] | select(.type=="session_meta") | .payload] | first // {}) as $meta
          | ([.[] | select(.type=="response_item" and .payload.type=="message" and .payload.role=="user")
                | .payload.content[]? | .text // empty
                | select(startswith("<")|not)
                | (if contains("User message from the Buddy bubble:\n") then split("User message from the Buddy bubble:\n")|last else . end)]
             | last // "") as $t
          | {agent:"codex", file:$f, id:($meta.id//""), cwd:($meta.cwd//""), title:($t|.[0:120]),
             mtime:($m|tonumber)}' 2>/dev/null
      done
    } | jq -cs --argjson own "$(for f in "$D"/sessions/*/claude-session "$D"/sessions/*/codex-thread; do
          [ -f "$f" ] && jq -cn --arg k "$(cat "$f")" --arg v "$(basename "$(dirname "$f")")" '{($k):$v}'
        done | jq -cs 'add // {}')" \
      '{type:"buddy_recent", sessions:(sort_by(-.mtime)|.[0:25]|map(. + {buddy:($own[.id] // "")}))}' | post
    exit 0 ;;
  transcript)
    A=${3:-}; F=${4:-}
    case "$F" in "$HOME"/.claude/projects/*.jsonl|"$HOME"/.codex/sessions/*.jsonl) ;; *) exit 2 ;; esac
    [ -f "$F" ] || exit 2
    if [ "$A" = claude ]; then
      tail -n 600 "$F" | jq -c 'select(.type=="user" or .type=="assistant")
        | {role:.message.role, text:(if (.message.content|type)=="string" then .message.content
            else ([.message.content[]? | select(.type=="text") | .text] | join("\n")) end)}
        | select(.text != "" and (.text|startswith("<")|not))' 2>/dev/null
    else
      tail -n 600 "$F" | jq -c 'select(.type=="response_item" and .payload.type=="message"
          and (.payload.role=="user" or .payload.role=="assistant"))
        | {role:.payload.role, text:([.payload.content[]? | .text // empty] | join("\n"))}
        | select(.text != "" and (.text|startswith("<")|not))' 2>/dev/null
    fi | tail -n 40 | jq -cs --arg f "$F" '{type:"buddy_transcript", file:$f, messages:map(.text |= .[0:2000])}' | post
    exit 0 ;;
  adopt)
    SID=${3:-}; A=${4:-}; AID=${5:-}
    valid_sid "$SID" && [[ "$AID" =~ ^[A-Za-z0-9-]{8,64}$ ]] || exit 2
    mkdir -p "$D/sessions/$SID"
    if [ "$A" = codex ]; then printf '%s' "$AID" > "$D/sessions/$SID/codex-thread"
    else printf '%s' "$AID" > "$D/sessions/$SID/claude-session"; fi
    exit 0 ;;
  stop)
    SID=${3:-}; valid_sid "$SID" || exit 2
    P=$D/sessions/$SID/pid
    if [ -f "$P" ]; then
      R=$(cat "$P")
      rm -f "$P"
      jq -cn --arg s "$SID" '{type:"buddy_stopped",buddy_session:$s}' | post
      [[ "$R" =~ ^[0-9]+$ ]] && end_run "$R"
    fi
    exit 0 ;;
  reap)
    # the app saw this chat's helper die without a word: what is left of its run goes, quietly
    SID=${3:-}; valid_sid "$SID" || exit 2
    P=$D/sessions/$SID/pid
    if [ -f "$P" ]; then
      R=$(cat "$P")
      rm -f "$P"
      [[ "$R" =~ ^[0-9]+$ ]] && end_run "$R"
    fi
    exit 0 ;;
  delete)
    SID=${3:-}; valid_sid "$SID" || exit 2
    S=$D/sessions/$SID
    [ -f "$S/pid" ] && kill_tree "$(cat "$S/pid")"
    # forget (an incognito chat): the agents own records of the conversation go too
    if [ "${4:-}" = forget ]; then
      # (with the conversations an agent had here before the chat was switched away and back: the .old lists)
      for c in $({ cat "$S/claude-session" 2>/dev/null; echo; cat "$S/claude-session.old" 2>/dev/null; }); do
        [[ "$c" =~ ^[A-Za-z0-9-]+$ ]] && rm -f "$HOME"/.claude/projects/*/"$c".jsonl
      done
      for t in $({ cat "$S/codex-thread" 2>/dev/null; echo; cat "$S/codex-thread.old" 2>/dev/null; }); do
        [[ "$t" =~ ^[A-Za-z0-9-]+$ ]] && find "$HOME/.codex/sessions" -name "rollout-*$t.jsonl" -delete 2>/dev/null
      done
      for p in $({ cat "$S/copilot-session" 2>/dev/null; echo; cat "$S/copilot-session.old" 2>/dev/null; }); do
        [[ "$p" =~ ^[A-Za-z0-9-]+$ ]] && rm -rf "$HOME/.copilot/session-state/$p"
      done
      for p in $({ cat "$S/pi-session" 2>/dev/null; echo; cat "$S/pi-session.old" 2>/dev/null; }); do
        [[ "$p" =~ ^[A-Za-z0-9._-]+$ ]] && rm -f "$HOME"/.pi/agent/sessions/*/*_"$p".jsonl
      done
      for o in $({ cat "$S/opencode-session" 2>/dev/null; echo; cat "$S/opencode-session.old" 2>/dev/null; }); do
        [[ "$o" =~ ^[A-Za-z0-9_-]+$ ]] && have opencode && timeout 30 opencode session delete $(oc2 && echo --standalone) "$o" >/dev/null 2>&1
      done
    fi
    rm -rf "${S:?}"
    exit 0 ;;
  prune)
    # The folders of chats Buddy no longer has (dropped before 2.2.26, when Buddy kept 20 chats, or lost): the chats
    # it has come as one comma-separated list. Never with an empty list, never a running chat's or one touched in the
    # last hour (a chat being made), and only folders named as Buddy names chats.
    KEEP=${3:-}
    [[ "$KEEP" =~ ^[0-9a-f]{12}(,[0-9a-f]{12})*$ ]] || exit 2
    for d in "$D"/sessions/*/; do
      n=$(basename "$d")
      [[ "$n" =~ ^[0-9a-f]{12}$ ]] || continue
      case ",$KEEP," in *",$n,"*) continue ;; esac
      [ -f "$d/pid" ] && kill -0 "$(cat "$d/pid")" 2>/dev/null && continue
      [ -n "$(find "$d" -maxdepth 0 -mmin -60)" ] && continue
      rm -rf "${d:?}"
    done
    exit 0 ;;
  ask) SID=${3:-}; BACKEND=${4:-claude}; DEV=${5:-0}; MSG=${6:-}; MODEL=${7:-}; FILES=${8:-}; EFFORT=${9:-}
    [[ "$EFFORT" =~ ^[a-z]{1,16}$ ]] || EFFORT="" # the agent's own level names, whatever they are
    FRESH=${10:-}; LITE=0; [ "${11:-}" = lite ] && LITE=1; FOLDER=${12:-} ;;
  *) echo "usage: buddy-run <token> ask|stop|reap|delete|prune|ping|cmdprocs|cmdkill ..." >&2; exit 2 ;;
esac

valid_sid "$SID" || exit 2
[ -z "$MSG" ] && exit 0
# A model of a service saved in Buddy (Settings, Agents and models) comes as @service/model. The agent is pointed at
# the relay on Buddy, which adds the key (it never enters Linux); $D/providers/<service>.json says which kinds of
# address the service has and its models context sizes.
SVC="" SVCM=""
if [[ "${MODEL:-}" == @*/* ]]; then
  SVC=${MODEL#@}; SVC=${SVC%%/*}; SVCM=${MODEL#@*/}
  [[ "$SVC" =~ ^[a-z0-9-]+$ ]] || exit 2
fi
svc_window() {
  jq -r --arg m "$SVCM" '.models[$m].window // 0 | select(. > 0)' "$D/providers/$SVC.json" 2>/dev/null
}
S=$D/sessions/$SID
mkdir -p "$S"
# The chat's project folder (chat options): where its agent starts. A path inside the workspace, checked here again
# (never out of it by "..", a link, or an absolute path); with none, or one that isn't, the workspace itself.
CWD=$W
if [ -n "${FOLDER:-}" ]; then
  case "/$FOLDER/" in
    *//*|*/../*|*/./*|*$'\n'*) FOLDER="" ;;
  esac
  if [ -n "$FOLDER" ] && mkdir -p "$W/$FOLDER" 2>/dev/null; then
    real=$(cd "$W/$FOLDER" 2>/dev/null && pwd -P)
    case "$real" in "$(cd "$W" && pwd -P)"/*) CWD=$W/$FOLDER ;; *) FOLDER="" ;; esac
  else
    FOLDER=""
  fi
fi
# How a run ended when the agent itself said nothing: shown only if the run reported no error and wasn't stopped.
quiet_end() { jq -cn --arg text "$1" --arg s "$SID" '{type:"buddy_error",text:$text,quiet:true,buddy_session:$s}' | post; }
event() { jq -cn --arg type "$1" --arg text "${2:-}" --arg s "$SID" '{type:$type,text:$text,buddy_session:$s}' | post; }
tag() { jq -c --arg s "$SID" '. + {buddy_session:$s}' 2>/dev/null; }

if [ -f "$S/pid" ] && kill -0 "$(cat "$S/pid")" 2>/dev/null; then
  event buddy_error "This session is still working. Tap Stop first, or start another session."
  exit 75 # (Helper.BUSY: the run that is still going ends the chat's "working", this helper's end doesn't)
fi

# The chat was just switched to this agent: it starts a conversation of its own. One it had in this chat before
# knows nothing of what came since; the app sends the conversation so far along with the message.
if [ "${FRESH:-}" = fresh ]; then
  case "$BACKEND" in
    # (the id it had is kept aside: deleting an incognito chat removes that conversation's record too)
    claude) cat "$S/claude-session" >> "$S/claude-session.old" 2>/dev/null; echo >> "$S/claude-session.old"; rm -f "$S/claude-session" ;;
    codex) cat "$S/codex-thread" >> "$S/codex-thread.old" 2>/dev/null; echo >> "$S/codex-thread.old"; rm -f "$S/codex-thread" ;;
    opencode) cat "$S/opencode-session" >> "$S/opencode-session.old" 2>/dev/null; echo >> "$S/opencode-session.old"; rm -f "$S/opencode-session" ;;
    agy) rm -f "$S/agy-conversation" "$S/agy-conversation.new" ;;
    grok) rm -f "$S/grok-session" ;;
    copilot) cat "$S/copilot-session" >> "$S/copilot-session.old" 2>/dev/null; echo >> "$S/copilot-session.old"; rm -f "$S/copilot-session" ;;
    pi) cat "$S/pi-session" >> "$S/pi-session.old" 2>/dev/null; echo >> "$S/pi-session.old"; rm -f "$S/pi-session" ;;
  esac
fi

# From here this run says buddy_done however it ends: at its end, on an early exit, or stopped from outside (then the
# agent and what it started are stopped first). Only a kill -9 of this script says nothing: the app notices that.
RUN=""
trap 'event buddy_done' EXIT
trap '[ -n "$RUN" ] && kill_tree "$RUN"; rm -f "$S/pid"; exit 1' TERM INT HUP

if [ -n "$SVC" ] && [ ! -s "$D/providers/$SVC.json" ]; then
  event buddy_error "This chat's model is from a service that is no longer in Buddy. Pick another model."
  exit 0
fi

# Attachments: fetch them from the app (comma-separated ids) into this session's files folder.
ATT=()
IMGS=()
if [ -n "${FILES:-}" ]; then
  mkdir -p "$S/files"
  IFS=, read -ra ids <<< "$FILES"
  for id in "${ids[@]}"; do
    [[ "$id" =~ ^[A-Za-z0-9._-]{1,120}$ && "$id" != *..* ]] || continue
    if curl -s -f -m 120 -H "Authorization: Bearer $TOKEN" "$URL/file/$id" -o "$S/files/$id"; then
      ATT+=("$S/files/$id")
      case "${id,,}" in *.jpg|*.jpeg|*.png|*.webp|*.gif) IMGS+=("$S/files/$id") ;; esac
    else
      event buddy_error "Couldn't get the attachment ${id#*_} from Buddy."
    fi
  done
  if [ ${#ATT[@]} -gt 0 ]; then
    MSG="$MSG

[The user attached $( [ ${#ATT[@]} -eq 1 ] && echo "a file" || echo "${#ATT[@]} files" ), saved on this phone. Open them with your Read tool (images show as pictures):
$(printf -- '- %s\n' "${ATT[@]}")]"
  fi
fi

SYSTEM=$(cat "$D/system-prompt.md" 2>/dev/null)
# In a project folder, Codex, Antigravity and Copilot no longer read the workspace's AGENTS.md by themselves (measured
# in a plain folder and in a git one; Claude Code, OpenCode and Pi still do, Grok never did): it comes with Buddy's
# instructions, so the user's own lines in it (#61) hold in every project.
if [ "$CWD" != "$W" ] && [ -s "$W/AGENTS.md" ]; then
  case "$BACKEND" in
    codex|agy|copilot) SYSTEM="$SYSTEM

The workspace's instructions ($W/AGENTS.md; \"this folder\" in them is $W), which hold in this project too:
$(head -c 32768 "$W/AGENTS.md")" ;;
  esac
fi
PERMS=$(cat "$D/permissions.md" 2>/dev/null)
[ -n "$PERMS" ] && SYSTEM="$SYSTEM

$PERMS"
# the background browser (Settings): its tools and when to use them, while it is on; never in a rule run
BROWSER=0
[ -e "$D/browser-on" ] && [ "$DEV" != rule ] && BROWSER=1
[ "$BROWSER" = 1 ] && SYSTEM="$SYSTEM

$(cat "$D/browser-prompt.md" 2>/dev/null)"
if [ "$DEV" = 1 ]; then
  SYSTEM="$SYSTEM

Linux tools are ON in this chat: you may run shell commands and create or edit files. $(if [ "$CWD" = "$W" ]; then
  echo "Work inside $W (one folder per project)."
else
  echo "This chat belongs to the project in $CWD: you start there, and its work stays inside it. $W is the workspace it is in (one folder per project)."
fi)
$(if [ "$CWD" = "$W" ]; then
  echo "Before building an Android app, read the android-app skill (Claude Code) or AGENTS.md (Codex, OpenCode, Antigravity, Grok, Copilot, Pi) in $W and follow it."
else # (from a project folder not every agent lists the workspace's skill: measured, Claude Code and Copilot in a git one)
  echo "Before building an Android app, read $W/.claude/skills/android-app/SKILL.md and follow it; where it says ~/.buddy/work/<appname>, this chat's app folder is $CWD."
fi)
Files the user sends for Linux tools arrive in $S/incoming (the message gives the path; they can be gigabytes). unzip and tar are installed; 7z needs apk add 7zip first."
  # Settings, GitHub: git and gh are signed in to the user account
  [ -s "$HOME/.config/gh/hosts.yml" ] && SYSTEM="$SYSTEM
git and the GitHub CLI (gh) are signed in to the user's GitHub account: you can clone, commit, push and open pull requests.
Pushing, creating a repository, and opening an issue or pull request are outward-facing: call confirm first with what you will do."
elif [ "$DEV" = 0 ]; then
  SYSTEM="$SYSTEM

Linux tools are off in this chat: no shell commands or file edits. If the user asks for something that needs them
(building an app, running commands), tell them to turn on Linux tools with the chip under this chat's title, then ask again."
fi

# Buddy's shared skills (Settings, Skills) live in ~/.agents/skills, where Codex and OpenCode look: Claude Code gets a
# link to each in its own folder (a skill of the same name already there wins), and links to removed ones go.
link_skills() {
  local d n l
  mkdir -p "$HOME/.claude/skills"
  for d in "$HOME"/.agents/skills/*/; do
    [ -f "$d/SKILL.md" ] || continue
    n=$(basename "$d")
    [ -e "$HOME/.claude/skills/$n" ] || [ -L "$HOME/.claude/skills/$n" ] || ln -s "${d%/}" "$HOME/.claude/skills/$n"
  done
  for l in "$HOME"/.claude/skills/*; do
    [ -L "$l" ] && [ ! -e "$l" ] && rm -f "$l"
  done
  return 0
}

# The user's own MCP servers that are switched on (Settings, MCP servers), as [{name, tools, sigs}]. An agent reaches
# each one on Buddy itself ($URL/mcpx/<name>, with Buddy's token): Buddy passes the calls on with the server's key,
# which never enters Linux. None in a notification rule's run (it works for someone else's message).
mcp_extra() {
  if [ "${DEV:-}" = rule ] || [ ! -s "$D/mcp-servers.json" ]; then echo '[]'; return; fi
  jq -c '[.[] | select((.name // "") | test("^[a-z0-9_]{1,32}$")) | select(.name != "phone")]' "$D/mcp-servers.json" 2>/dev/null || echo '[]'
}
# A line for the agents that list MCP tools only by file (agy, grok): the other servers and their tools.
mcp_extra_note() {
  jq -r 'map(select((.sigs // "") != "") | "\"" + .name + "\": " + .sigs) | if length > 0 then
    " The user also set up these MCP servers of their own; use their tools when the request calls for them: " + join("; ") + "."
    else "" end' <<<"$EXTRA" 2>/dev/null
}

EXTRA=$(mcp_extra)

# ---------------------------------------------------------------- Claude Code
run_claude() {
  local mcp tools n
  mcp=$(jq -cn --arg url "$URL/mcp?chat=$SID" --arg base "$URL/mcpx/" --arg auth "Bearer $TOKEN" --argjson x "$EXTRA" \
    '{mcpServers:({phone:{type:"http",url:$url,headers:{Authorization:$auth},timeout:600000}}
      + ($x | map({key:.name, value:{type:"http",url:($base + .name),headers:{Authorization:$auth},timeout:600000}}) | from_entries))}')
  link_skills
  tools=("mcp__phone" "WebSearch" "WebFetch" "Read(/$S/files/**)" "Read(/$D/GUIDE.md)" "Skill"
    "Read(/$HOME/.agents/skills/**)" "Read(/$HOME/.claude/skills/**)")
  [ "$DEV" = rule ] && tools=("mcp__phone")
  for n in $(jq -r '.[].name' <<<"$EXTRA"); do tools+=("mcp__$n"); done
  # Claude Code's own sub-agents (Agent, once Task) are off: Buddy can't show them, give each a screen or keep them to
  # looking things up. The phone server's delegate tool starts sub-agents the user sees and can open.
  local deny=(--disallowedTools "Agent" "Task")
  [ "$DEV" = rule ] && deny=(--disallowedTools "Agent" "Task" "Bash" "WebFetch" "WebSearch" "Write" "Edit" "NotebookEdit" "Skill")
  [ "$DEV" = 1 ] && tools+=("Bash" "Read" "Write" "Edit" "Glob" "Grep" "Skill")
  local args=(-p "$MSG" --output-format stream-json --verbose
    --mcp-config "$mcp" --strict-mcp-config
    --allowedTools "${tools[@]}" "${deny[@]}"
    --append-system-prompt "$SYSTEM")
  [ -s "$S/claude-session" ] && args+=(--resume "$(cat "$S/claude-session")")
  [ -n "${MODEL:-}" ] && args+=(--model "${SVCM:-$MODEL}")
  [ -n "${EFFORT:-}" ] && args+=(--effort "$EFFORT")
  # a service saved in Buddy: every model Claude Code would pick (its helpers and subagents too) is the chosen one, and it
  # gets the real context size, not the one it guesses for a model it does not know; the plan stays for the rest
  local keyenv=()
  if [ -n "$SVC" ]; then
    keyenv=(env -u ANTHROPIC_API_KEY ANTHROPIC_BASE_URL="$URL/llm/$SVC/a" ANTHROPIC_AUTH_TOKEN="$TOKEN"
      ANTHROPIC_MODEL="$SVCM" ANTHROPIC_DEFAULT_OPUS_MODEL="$SVCM" ANTHROPIC_DEFAULT_SONNET_MODEL="$SVCM"
      ANTHROPIC_DEFAULT_HAIKU_MODEL="$SVCM" CLAUDE_CODE_SUBAGENT_MODEL="$SVCM")
    local win
    win=$(svc_window)
    [ -n "$win" ] && keyenv+=(CLAUDE_CODE_MAX_CONTEXT_TOKENS="$win")
  fi
  cd "$CWD" && "${keyenv[@]}" claude "${args[@]}" 2>"$S/last-error.log"
}

stream_claude() {
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    [ "$line" = "$AGENT_END" ] && break
    printf '%s' "$line" | tag | post
    sid=$(printf '%s' "$line" | jq -r 'select(.session_id != null) | .session_id' 2>/dev/null)
    [ -n "$sid" ] && printf '%s' "$sid" > "$S/claude-session"
  done
}

# ---------------------------------------------------------------------- Codex
# The phone server is passed with -c (no config file needed). Only the phone tools are
# pre-approved. Normal mode keeps Codex's shell read-only; developer mode opens all of Buddy's Linux to it.
run_codex() {
  local prompt=$MSG
  local cfg=(-c 'mcp_servers.phone.url="'"$URL"'/mcp?chat='"$SID"'"'
    -c 'mcp_servers.phone.bearer_token_env_var="BUDDY_TOKEN"'
    -c 'mcp_servers.phone.default_tools_approval_mode="approve"'
    -c 'mcp_servers.phone.tool_timeout_sec=600')
  local n
  for n in $(jq -r '.[].name' <<<"$EXTRA"); do
    cfg+=(-c 'mcp_servers.'"$n"'.url="'"$URL"'/mcpx/'"$n"'"'
      -c 'mcp_servers.'"$n"'.bearer_token_env_var="BUDDY_TOKEN"'
      -c 'mcp_servers.'"$n"'.default_tools_approval_mode="approve"'
      -c 'mcp_servers.'"$n"'.tool_timeout_sec=600')
  done
  # Linux tools off (and a rule's run): no shell at all, as for Claude Code, not even read-only commands
  local sandbox=(--sandbox read-only --disable shell_tool --disable unified_exec)
  # developer mode: the whole of Buddy's Linux, like Claude Code's Bash and OpenCode (so apk add works too)
  [ "$DEV" = 1 ] && sandbox=(--sandbox danger-full-access)
  # a run with a file attached (not a picture, which goes in with --image) keeps read-only commands to open it
  [ "$DEV" != 1 ] && [ ${#ATT[@]} -gt ${#IMGS[@]} ] && sandbox=(--sandbox read-only)
  # a service saved in Buddy: through the relay, over plain requests (no WebSocket, which other services refuse), with the
  # real context size
  if [ -n "$SVC" ]; then
    # another service than OpenAI's own: none of the ChatGPT plan's extras (apps, sub-agents, goals), which its
    # models weren't made for, and whose ~200 KB of tool descriptions swamp a local model
    [ "$(jq -r '.openai_own // false' "$D/providers/$SVC.json" 2>/dev/null)" = true ] \
      || cfg+=(-c features.apps=false -c features.multi_agent=false -c features.goals=false -c features.tool_suggest=false)
    # a model on the user's own computer can read for many minutes before its first word: 15, as Buddy waits
    local idle=""
    [ "$(jq -r '.local // false' "$D/providers/$SVC.json" 2>/dev/null)" = true ] && idle=',stream_idle_timeout_ms=900000'
    cfg+=(-c 'model_provider="buddy-key"'
      -c 'model_providers.buddy-key={name="API key",base_url="'"$URL/llm/$SVC/o"'",wire_api="responses",env_key="BUDDY_TOKEN",supports_websockets=false'"$idle"'}')
    local win
    win=$(svc_window)
    [ -n "$win" ] && cfg+=(-c "model_context_window=$win")
  fi
  [ -n "${MODEL:-}" ] && cfg+=(-m "${SVCM:-$MODEL}")
  [ -n "${EFFORT:-}" ] && cfg+=(-c "model_reasoning_effort=\"$EFFORT\"")
  local img=() f
  for f in "${IMGS[@]}"; do img+=("--image=$f"); done
  cd "$CWD" || return 1
  if [ -s "$S/codex-thread" ]; then
    BUDDY_TOKEN=$TOKEN codex exec "${cfg[@]}" "${sandbox[@]}" --json --skip-git-repo-check \
      resume "${img[@]}" -- "$(cat "$S/codex-thread")" "$prompt" </dev/null 2>"$S/last-error.log"
  else
    # codex exec has no system-prompt flag, so Buddy's instructions lead the first message.
    prompt="$SYSTEM"$'\n\n---\n\nUser message from the Buddy bubble:\n'"$MSG"
    BUDDY_TOKEN=$TOKEN codex exec "${cfg[@]}" "${sandbox[@]}" "${img[@]}" --json --skip-git-repo-check \
      -- "$prompt" </dev/null 2>"$S/last-error.log"
  fi
}

# Translate Codex's JSONL events into the Claude Code stream format the bubble understands.
stream_codex() {
  local pics_since="$S/codex-pictures-since"
  : > "$pics_since"
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    [ "$line" = "$AGENT_END" ] && break
    tid=$(printf '%s' "$line" | jq -r 'select(.type=="thread.started") | .thread_id // empty' 2>/dev/null)
    [ -n "$tid" ] && printf '%s' "$tid" > "$S/codex-thread"
    # Codex doesn't say which model it used; its session log does (shown when the chat is on "Default")
    if [ "$(printf '%s' "$line" | jq -r '.type // empty' 2>/dev/null)" = turn.completed ] && [ -s "$S/codex-thread" ]; then
      local log model
      log=$(find "$HOME/.codex/sessions" -name "rollout-*$(cat "$S/codex-thread").jsonl" 2>/dev/null | head -1)
      # pictures its image tool made this turn: it often doesn't name them, so the chat is told here
      find "$HOME/.codex/generated_images/$(cat "$S/codex-thread")" -type f -newer "$pics_since" 2>/dev/null | sort \
        | jq -Rsc --arg s "$SID" 'split("\n") | map(select(length > 0)) | select(length > 0)
            | {type:"buddy_pictures", paths:., buddy_session:$s}' 2>/dev/null | post
      : > "$pics_since"
      model=$([ -n "$log" ] && grep '"turn_context"' "$log" | tail -1 | jq -r '.payload.model // empty' 2>/dev/null)
      [ -n "$model" ] && jq -cn --arg m "$model" --arg s "$SID" '{type:"system", subtype:"model", model:$m, buddy_session:$s}' | post
      # how full the context is and its size, from the same token_count
      [ -n "$log" ] && grep '"token_count"' "$log" | tail -1 | jq -c --arg s "$SID" '.payload.info // empty
        | select(.model_context_window != null)
        | {type:"buddy_context", used:(.last_token_usage.total_tokens // 0), window:.model_context_window, buddy_session:$s}' \
        2>/dev/null | post
      # the plan's 5-hour and weekly limits, from the log's last token_count, passed on as Claude Code reports them
      [ -n "$log" ] && grep '"rate_limits"' "$log" | tail -1 | jq -c --arg s "$SID" '.payload.rate_limits // empty
        | [.primary, .secondary] | map(select(. != null and .window_minutes != null)
            | {key:(if .window_minutes <= 300 then "five_hour" else "seven_day" end),
               value:{utilization:((.used_percent // 0) / 100), resetsAt:(.resets_at // 0)}})
        | select(length > 0)
        | {type:"rate_limit_event", rate_limit_info:{unifiedWindows:from_entries}, buddy_session:$s}' 2>/dev/null | post
    fi
    printf '%s' "$line" | jq -c --arg s "$SID" '
      (if .type == "item.started" and .item.type == "mcp_tool_call" then
        {type:"assistant", message:{content:[{type:"tool_use",
          name:("mcp__" + (.item.server // "phone") + "__" + (.item.tool // "")),
          input:(.item.arguments // {})}]}}
      elif .type == "item.started" and .item.type == "command_execution" then
        {type:"assistant", message:{content:[{type:"tool_use", name:"Bash",
          input:{command:(.item.command // "")}}]}}
      elif .type == "item.completed" and .item.type == "file_change" then
        {type:"assistant", message:{content:[{type:"tool_use", name:"Edit", input:{}}]}}
      elif .type == "item.completed" and .item.type == "agent_message" then
        {type:"assistant", message:{content:[{type:"text", text:(.item.text // "")}]}}
      elif .type == "turn.completed" then
        {type:"result", subtype:"success", result:""}
      elif .type == "turn.failed" then
        {type:"result", subtype:"error", is_error:true, result:("Codex: " + (.error.message // "turn failed"))}
      elif .type == "error" then
        {type:"buddy_error", text:("Codex: " + (.message // "error"))}
      else empty end) | . + {buddy_session:$s}' 2>/dev/null | while IFS= read -r ev; do printf '%s' "$ev" | post; done
  done
}

# ------------------------------------------------------------------- OpenCode
# Config goes in through OPENCODE_CONFIG_CONTENT: the phone server, Buddy's instructions (a file), no
# auto-update or sharing. Normal mode sets shell and edits to "ask", which a non-interactive run
# auto-rejects ("deny" would drop those tools, and OpenCode's free models refuse a changed tool set).
run_opencode() {
  # Lite mode (Buddy's Lite, for small models): a short prompt, and the phone tools come a dozen at first (Buddy's
  # server gives this chat those, more_tools loads others); OpenCode's own tools, its skills and the user's other
  # MCP servers are left out. A small model reads its whole prompt again at every step.
  if [ "${LITE:-0}" = 1 ]; then
    { cat "$D/lite-prompt.md"; [ -n "$PERMS" ] && printf '\n%s\n' "$PERMS"; } > "$S/system.md"
  else
  # OpenCode names MCP tools <server>_<tool>; small models otherwise call "read_screen" and give up
  printf '%s\n\n%s\n' "$SYSTEM" "In this app the phone tools are named with a phone_ prefix: phone_read_screen, phone_tap, \
phone_long_press, phone_type_text, phone_scroll, phone_swipe, phone_press, phone_open_app, phone_list_apps, phone_open_url, \
phone_screenshot, phone_wait, phone_confirm, phone_ask, phone_notify, phone_reply_notification, phone_schedule_message, phone_list_scheduled, phone_cancel_scheduled, phone_update_buddy, phone_install_apk and phone_wait_for_install\
$([ "$BROWSER" = 1 ] && printf '%s' ", and for the background browser phone_browser_open, phone_browser_read, phone_browser_click, \
phone_browser_type, phone_browser_scroll, phone_browser_screenshot, phone_browser_back and phone_browser_tabs"). Always call them by \
these exact names. Right at the start of a chat they can still be connecting: if one answers that there is no such \
tool, it's not missing, call it again in your next step." > "$S/system.md"
  fi
  local cfg v2=0
  oc2 && v2=1
  # OpenCode 2 before 2.3 ignores instructions given through OPENCODE_CONFIG_CONTENT (the model never saw this
  # prompt), but reads its global AGENTS.md, next to the work folder's own. Buddy owns that file (marked on line 1)
  # and leaves one the user wrote alone. 2.3 reads both, so there Buddy's copy goes: the prompt came twice.
  if [ "$v2" = 1 ]; then
    local g=$HOME/.config/opencode/AGENTS.md ocv
    ocv=$(jq -r '.version // ""' "$(dirname "$(dirname "$(readlink -f "$(command -v opencode)")")")/package.json" 2>/dev/null)
    [ -n "$ocv" ] || ocv=$(opencode --version 2>/dev/null | grep -o '[0-9][0-9.]*' | head -1) # (a standalone binary)
    if [ ! -s "$g" ] || head -1 "$g" | grep -q '^<!-- buddy -->'; then
      if [ -n "$ocv" ] && [ "$(printf '%s\n2.3.0\n' "$ocv" | sort -V | head -1)" = 2.3.0 ]; then
        rm -f "$g"
      else # (a version it can't tell is taken as an older one: the prompt twice beats none)
        mkdir -p "${g%/*}" && { echo '<!-- buddy -->'; cat "$S/system.md"; } > "$g"
      fi
    fi
  fi
  # OpenCode 2 only takes codemode under mcp.servers; without it the phone tools hide behind one "execute" tool
  local x=$EXTRA
  [ "${LITE:-0}" = 1 ] && x='[]'
  cfg=$(jq -cn --arg url "$URL/mcp?chat=$SID" --arg base "$URL/mcpx/" --arg auth "Bearer $TOKEN" --arg sys "$S/system.md" \
    --arg dev "$DEV" --arg v2 "$v2" --arg lite "${LITE:-0}" --arg att "${#ATT[@]}" --argjson x "$x" '
    {type:"remote", url:$url, headers:{Authorization:$auth}, oauth:false} as $phone
    | ({phone:$phone} + ($x | map({key:.name, value:($phone + {url:($base + .name)})}) | from_entries)) as $all
    | (if $v2 == "1" then {mcp:{servers:($all | map_values(. + {codemode:false, timeout:{execution:600000}}))}}
       else {mcp:($all | map_values(. + {timeout:600000}))} end)
    + {instructions:[$sys], autoupdate:false, share:"disabled"}
    + (if $dev == "1" then {} elif $dev == "rule" then {permission:{bash:"ask", edit:"ask", webfetch:"ask"}}
       else {permission:{bash:"ask", edit:"ask"}} end)
    # lite: only the phone tools. Not those OpenCode has itself, nor those of MCP servers in the OpenCode config of
    # the user (one there for reverse engineering came to ~245k tokens, five times the window of a small model: #67).
    # The last matching entry wins, so "*" goes first. (OpenCode keeps its skill tool whatever this says.)
    + (if $lite == "1" then {tools:({"*":false, "phone_*":true}
        + (if $att == "0" then {} else {read:true} end))} else {} end)') # (attachments are opened with read)
  # a service saved in Buddy: a provider of its own, pointed at the relay (OpenAI-style when it has that address)
  if [ -n "$SVC" ]; then
    cfg=$(jq -c --argjson c "$cfg" --arg url "$URL/llm/$SVC" --arg t "$TOKEN" --arg id "buddy-$SVC" '
      (if .local == true then {timeout:900000} else {} end) as $wait   # a local model: 15 minutes, as Buddy waits
      | (if .openai != "" then {npm:"@ai-sdk/openai-compatible", options:({baseURL:($url + "/o"), apiKey:$t} + $wait)}
       else {npm:"@ai-sdk/anthropic", options:({baseURL:($url + "/a/v1"), apiKey:$t} + $wait)} end) as $p
      | $c + {provider:{($id):($p + {name:.name, models:(.models | with_entries(.value = ({name:.value.name}
          + (if .value.window > 0 then {limit:{context:.value.window, output:([.value.window / 4, 32000] | min | floor)}}
             else {} end))))})}}' "$D/providers/$SVC.json") || return 1
  fi
  local args=(run --format json)
  [ "$v2" = 1 ] && args+=(--standalone)
  [ -s "$S/opencode-session" ] && args+=(-s "$(cat "$S/opencode-session")")
  [ -n "$SVC" ] && MODEL="buddy-$SVC/$SVCM"
  [ -n "${MODEL:-}" ] && args+=(-m "$MODEL")
  local f
  for f in "${ATT[@]}"; do args+=(-f "$f"); done
  cd "$CWD" && OPENCODE_CONFIG_CONTENT=$cfg opencode "${args[@]}" -- "$MSG" </dev/null 2>"$S/last-error.log"
}

# Translate OpenCode's JSON events into the Claude Code stream format the bubble understands.
# Only the text of the step that ends the turn (its answer) is shown: text written before tool calls is
# the model thinking out loud (free models even leak their reasoning, ending in </think>), and Buddy
# doesn't show Claude Code's or Codex's thinking either. Tool calls still show as steps.
stream_opencode() {
  local pending="" failed="" line sid typ t
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    [ "$line" = "$AGENT_END" ] && break
    sid=$(printf '%s' "$line" | jq -r '.sessionID // empty' 2>/dev/null)
    [ -n "$sid" ] && printf '%s' "$sid" > "$S/opencode-session"
    typ=$(printf '%s' "$line" | jq -r '.type // empty' 2>/dev/null)
    [ "$typ" = error ] && failed=1
    case "$typ" in
      step_start) pending="" ;;
      text)
        t=$(printf '%s' "$line" | jq -r '.part.text // "" | gsub("(?s)<think>.*?</think>"; "") | split("</think>") | last
          | sub("^\\s+"; "") | sub("\\s+$"; "")' 2>/dev/null)
        [ -n "$t" ] && pending="${pending:+$pending$'\n\n'}$t" ;;
      step_finish)
        if [ "$(printf '%s' "$line" | jq -r '.part.reason // empty' 2>/dev/null)" = stop ]; then
          [ -n "$pending" ] && jq -cn --arg t "$pending" --arg s "$SID" \
            '{type:"assistant", message:{content:[{type:"text", text:$t}]}, buddy_session:$s}' | post
          jq -cn --arg s "$SID" '{type:"result", subtype:"success", result:"", buddy_session:$s}' | post
        fi
        pending="" ;;
      tool_use|error)
        printf '%s' "$line" | jq -c --arg s "$SID" '
          (if .type == "tool_use" and .part.tool == "invalid" then empty   # a mistyped tool name; the model retries
          elif .type == "tool_use" and .part.tool == "execute" then empty  # OpenCode 2 code tool (the phone is not in it)
          elif .type == "tool_use" then
            (.part.tool // "") as $t
            | {type:"assistant", message:{content:[{type:"tool_use",
                name:(if ($t | startswith("phone_")) then "mcp__phone__" + ($t | ltrimstr("phone_"))
                      elif ($t == "bash" or $t == "shell") then "Bash" elif ($t == "edit" or $t == "write" or $t == "patch") then "Edit"
                      elif $t == "read" then "Read" else $t end),
                input:((.part.state.input // {}) + (if ($t == "phone_confirm" or $t == "phone_ask")
                  then {_answer:(.part.state.output // "")} else {} end))}]}}
          else
            {type:"result", subtype:"error", is_error:true,
             result:((.error.data.message // .error.message // .error.name // .error.type // "error") as $m
               | if ($m | test("free tier"; "i")) then "OpenCode free models turned this request down (they sometimes do when busy). Try again in a moment, or pick another model."
                 else "OpenCode: " + $m end)}
          end) | . + {buddy_session:$s}' 2>/dev/null | while IFS= read -r ev; do printf '%s' "$ev" | post; done ;;
    esac
  done
  # OpenCode 2 sometimes ends without the last step_finish: still show the answer
  if [ -n "$pending" ] && [ -z "$failed" ]; then
    jq -cn --arg t "$pending" --arg s "$SID" '{type:"assistant", message:{content:[{type:"text", text:$t}]}, buddy_session:$s}' | post
    jq -cn --arg s "$SID" '{type:"result", subtype:"success", result:"", buddy_session:$s}' | post
  fi
}

# ---------------------------------------------------------------- Antigravity
# agy reads MCP servers only from ~/.gemini/config/mcp_config.json and permissions from its settings.json, but each
# chat needs its own phone address (?chat=) and mode. So every run gets its own HOME: its own config and settings,
# with everything else (the sign-in, conversations) linked to the real ~/.gemini/antigravity-cli.
# Only the phone tools (and the chat's attachments) are pre-approved; developer mode skips agy's permission checks,
# like Codex's full access. timeoutSeconds: an approval card may wait for the user (10 minutes, as for the others).
AGY_PHONE_TOOLS='["read_screen","tap","long_press","type_text","scroll","swipe","press","open_app","list_apps","open_url",
"screenshot","wait","confirm","ask","notify","reply_notification","schedule_message","list_scheduled","cancel_scheduled",
"update_buddy","install_apk","wait_for_install","point_out"]'
run_agy() {
  local h=$S/agy-home g=$HOME/.gemini/antigravity-cli f list tools sigs
  mkdir -p "$h/.gemini/config" "$h/.gemini/antigravity-cli" "$g" "$HOME/.gemini/config"
  keep_login "$h/.gemini/antigravity-cli/antigravity-oauth-token" "$g/antigravity-oauth-token"
  for f in "$g"/* "$g"/.[!.]*; do
    [ -e "$f" ] || continue
    case "${f##*/}" in settings.json|brain) continue ;; esac
    ln -sfn "$f" "$h/.gemini/antigravity-cli/${f##*/}"
  done
  # agy saves a long tool result (list_apps, …) under brain/<conversation>/ and has the model read it back, but it
  # only lets the model read inside its own folder, and a link out of it doesn't count: each chat keeps its own brain/
  [ -L "$h/.gemini/antigravity-cli/brain" ] && rm -f "$h/.gemini/antigravity-cli/brain"
  mkdir -p "$h/.gemini/antigravity-cli/brain"
  for f in "$HOME/.gemini/config"/*; do
    [ -e "$f" ] && [ "${f##*/}" != mcp_config.json ] && ln -sfn "$f" "$h/.gemini/config/${f##*/}"
  done
  ( umask 077
    jq -n --arg url "$URL/mcp?chat=$SID" --arg base "$URL/mcpx/" --arg auth "Bearer $TOKEN" --argjson x "$EXTRA" \
      '{mcpServers:({phone:{url:$url, headers:{Authorization:$auth}, timeoutSeconds:600}}
        + ($x | map({key:.name, value:{url:($base + .name), headers:{Authorization:$auth}, timeoutSeconds:600}}) | from_entries))}' \
      > "$h/.gemini/config/mcp_config.json" )
  # the phone's tools as the server lists them (a newer Buddy may have more); the known list if that fails
  list=$(curl -s -m 10 -X POST -H "Authorization: Bearer $TOKEN" -H 'Content-Type: application/json' \
    -H 'Accept: application/json, text/event-stream' --data '{"jsonrpc":"2.0","id":1,"method":"tools/list"}' \
    "$URL/mcp?chat=$SID")
  tools=$(jq -c '[.result.tools[].name] | select(length > 0)' <<<"$list" 2>/dev/null)
  # and their arguments, "tap(element?, x?, y?)": agy itself only lists tool names, and reads a tool's description
  # file before using it (a model round trip each), or guesses the arguments
  sigs=$(jq -r '[.result.tools[] | (.inputSchema.required // []) as $req | "\(.name)(" + ((.inputSchema.properties // {})
    | keys_unsorted | map(. as $k | if ($req | index($k)) != null then $k else $k + "?" end) | join(", ")) + ")"]
    | join(", ")' <<<"$list" 2>/dev/null)
  jq -n --argjson t "${tools:-$AGY_PHONE_TOOLS}" --arg files "$S/files" --arg brain "$h/.gemini/antigravity-cli/brain" \
    --argjson x "$EXTRA" \
    '{permissions:{allow:([$t[] | "mcp(phone/\(.))"] + [$x[] | .name as $n | (.tools // [])[] | "mcp(\($n)/\(.))"]
      + ["read_file(\($files))", "read_file(\($brain))"])}}' \
    > "$h/.gemini/antigravity-cli/settings.json"
  local prompt=$MSG args names note
  # agy has no system-prompt flag, so Buddy's instructions lead a new conversation's first message (as for Codex).
  # It also lists MCP tools only by file: say how to call the phone's, or it goes looking (e.g. with ls, which a
  # normal chat refuses, and then it stops).
  [ -n "$sigs" ] || sigs=$(jq -r 'join(", ")' <<<"$AGY_PHONE_TOOLS" 2>/dev/null)
  note="In this app the phone tools are on the MCP server named \"phone\". Call them right away with call_mcp_tool \
(ServerName \"phone\", the ToolName and its Arguments as listed here; ? marks an optional one): $sigs. You don't need \
to read their descriptions first; only if an argument is unclear, read_file \
$h/.gemini/antigravity-cli/mcp/phone/<tool>.json.$(mcp_extra_note)"
  [ "$DEV" = 1 ] || note="$note Shell commands are not available in this chat; don't try them."
  [ -s "$S/agy-conversation" ] || prompt="$SYSTEM"$'\n\n'"$note"$'\n\n---\n\nUser message from the Buddy bubble:\n'"$MSG"
  args=(-p "$prompt" --output-format stream-json)
  [ -s "$S/agy-conversation" ] && args+=(--conversation "$(cat "$S/agy-conversation")")
  [ -n "${MODEL:-}" ] && args+=(--model "$MODEL")
  [ -n "${EFFORT:-}" ] && args+=(--effort "$EFFORT")
  [ "$DEV" = 1 ] && args+=(--dangerously-skip-permissions)
  rm -f "$S/agy-error"
  cd "$CWD" && HOME=$h agy "${args[@]}" </dev/null 2>"$S/last-error.log"
  local status=$?
  # a token refresh that replaced the link with a file: keep the new token in the real folder
  f=$h/.gemini/antigravity-cli/antigravity-oauth-token
  [ -f "$f" ] && [ ! -L "$f" ] && mv -f "$f" "$g/antigravity-oauth-token" && ln -sfn "$g/antigravity-oauth-token" "$f"
  return $status
}

# Translate agy's stream-json events (init, step_update, result) into the Claude Code stream format.
# A step's text arrives in pieces (text_delta) and is shown once the step is done; a tool step shows once.
# agy ends its turn when a permission is refused (no one to ask), often without a word. Then, unless this is the
# last try ($1 = last), the result isn't shown and $S/agy-denied says what was refused, for one nudge.
stream_agy() {
  local line typ idx state ev t denied="" said=""
  declare -A text=() shown=()
  rm -f "$S/agy-denied"
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    [ "$line" = "$AGENT_END" ] && break
    printf '%s\n' "$line" >> "$S/agy-last.jsonl"   # the run's raw events stay, for checking how agy reports its steps
    typ=$(printf '%s' "$line" | jq -r '.event // empty' 2>/dev/null)
    case "$typ" in
      init)
        printf '%s' "$line" | jq -r '.conversation_id // .init.conversation_id // empty' 2>/dev/null > "$S/agy-conversation.new"
        if [ -s "$S/agy-conversation.new" ]; then mv "$S/agy-conversation.new" "$S/agy-conversation"; else rm -f "$S/agy-conversation.new"; fi ;;
      step_update)
        idx=$(printf '%s' "$line" | jq -r '.step_update.step_index // 0' 2>/dev/null)
        state=$(printf '%s' "$line" | jq -r '.step_update.state // empty' 2>/dev/null)
        case "$(printf '%s' "$line" | jq -r '.step_update.step_type // empty' 2>/dev/null)" in
          user_input) ;;
          agent_response)
            text[$idx]+=$(printf '%s' "$line" | jq -j '.step_update.text_delta // ""' 2>/dev/null; printf x)
            text[$idx]=${text[$idx]%x}
            if [ "$state" = DONE ] && [ -z "${shown[$idx]:-}" ]; then
              shown[$idx]=1
              t=$(printf '%s' "${text[$idx]}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
              [ -n "$t" ] && said=1
              [ -n "$t" ] && jq -cn --arg t "$t" --arg s "$SID" \
                '{type:"assistant", message:{content:[{type:"text", text:$t}]}, buddy_session:$s}' | post
            fi ;;
          *)
            # a tool step (step_type "tool"): its tool_info has the name and parameters; a phone tool comes as
            # call_mcp_tool with {ServerName, ToolName, Arguments}. Before agy first uses an MCP tool it reads the
            # tool's description file from its own folder (…/antigravity-cli/mcp/<server>/<tool>.json), and it reads a
            # long result back from …/antigravity-cli/brain/…/output.txt: neither is shown.
            if [ "$state" = ERROR ]; then
              # refused by its permissions (a shell command in a normal chat, …): say so under the step
              t=$(printf '%s' "$line" | jq -r '.step_update as $u | ($u.tool_info // {}) as $i
                | select(($i.error.message // "") | test("denied permission|permission check failed"; "i"))
                | ($i.parameters.CommandLine // $u.tool_name // $i.name // "?")' 2>/dev/null)
              if [ -n "$t" ]; then
                denied=$t
                jq -cn --arg t "Not allowed in this chat: $t" --arg s "$SID" '{type:"buddy_step", text:$t, buddy_session:$s}' | post
              fi
              continue
            fi
            [ -n "${shown[$idx]:-}" ] && continue
            ev=$(printf '%s' "$line" | jq -c --arg s "$SID" '
              .step_update as $u | ($u.tool_info // {}) as $i | ($i.parameters // {}) as $p
              | ($u.tool_name // $i.name // "") as $t
              | select($t != "")
              | select(([$t] | inside(["finish", "wait", "wait_5_seconds", "list_permissions", "ask_permission",
                  "ask_custom_permission"])) | not)
              | select(($t == "read_file" or $t == "view_file") and (($p.Path // "") | test("/antigravity-cli/(mcp|brain)/")) | not)
              | (($p.Arguments // {}) | if type == "string" then (fromjson? // {}) else . end) as $args
              | {type:"assistant", message:{content:[{type:"tool_use",
                  name:(if $t == "call_mcp_tool" then "mcp__" + ($p.ServerName // "phone") + "__" + ($p.ToolName // "")
                        elif $t == "run_command" or $t == "send_command_input" then "Bash"
                        elif ($t | test("^(write_to_file|replace_file_content|multi_replace_file_content|sed_file|notebook_edit)$")) then "Edit"
                        elif $t == "read_file" or $t == "view_file" then "Read" elif $t == "search_web" then "WebSearch"
                        elif $t == "read_url_content" then "WebFetch" else $t end),
                  input:(if $t == "call_mcp_tool" then (if ($args | type) == "object" then $args else {} end)
                         else ({command:($p.CommandLine // $p.Command // null),
                                file_path:($p.Path // $p.TargetFile // $p.AbsolutePath // $p.FilePath // null),
                                query:($p.Query // null), url:($p.Url // $p.URL // null)}
                               | with_entries(select(.value != null and (.value | type) == "string"))) end)}]},
                buddy_session:$s}' 2>/dev/null)
            [ -n "$ev" ] && { printf '%s' "$ev" | post; shown[$idx]=1; }
            ;;
        esac ;;
      result)
        if [ "$(printf '%s' "$line" | jq -r '.result.status // empty' 2>/dev/null)" = SUCCESS ]; then
          # a refused file read shows only here, in denied_actions (its step just ends without output)
          if [ -z "$denied" ]; then
            denied=$(printf '%s' "$line" | jq -r '[.result.denied_actions[]? | .display_name // .action] | unique | join(", ")' 2>/dev/null)
            [ -n "$denied" ] && jq -cn --arg t "Not allowed in this chat: $denied" --arg s "$SID" \
              '{type:"buddy_step", text:$t, buddy_session:$s}' | post
          fi
          if [ -n "$denied" ] && [ -z "$said" ]; then
            if [ "${1:-}" = last ]; then
              jq -cn --arg s "$SID" --arg d "$denied" '{type:"result", subtype:"error", is_error:true,
                result:("Antigravity stopped after this chat refused: " + $d), buddy_session:$s}' | post
            else
              printf '%s' "$denied" > "$S/agy-denied"
            fi
          else
            jq -cn --arg s "$SID" '{type:"result", subtype:"success", result:"", buddy_session:$s}' | post
          fi
        else
          printf '%s' "$line" | jq -r '.result.error // "the request failed"' 2>/dev/null > "$S/agy-error"
          jq -cn --arg s "$SID" --arg e "$(cat "$S/agy-error")" \
            '{type:"result", subtype:"error", is_error:true, result:("Antigravity: " + $e), buddy_session:$s}' | post
        fi ;;
    esac
  done
}

# ----------------------------------------------------------------------- Grok
# grok reads MCP servers from ~/.grok/config.toml (and Claude Code's ~/.claude.json), but each chat needs its own phone
# address (?chat=). So every run gets its own GROK_HOME: the user's config.toml without its MCP servers, plus the phone
# with a 10-minute tool timeout (an approval card may wait for the user), and everything else (the sign-in, sessions)
# linked to the real ~/.grok. A headless run refuses what isn't pre-approved: the phone tools are; normal mode offers
# only the web and (once the chat has attachments) file reads, a rule's run only the phone; developer mode approves
# everything, like Codex's full access.
# grok's bundled skills (docx, pptx, code-review, …), found once per grok version: a phone chat turns them off
grok_bundled_skills() {
  local v f
  v=$(grok --version 2>/dev/null | awk '{print $2}')
  f=$D/grok-bundled-skills-${v:-unknown}
  if [ ! -s "$f" ]; then
    rm -f "$D"/grok-bundled-skills-*
    (cd /tmp && GROK_CLAUDE_SKILLS_ENABLED=0 GROK_CURSOR_SKILLS_ENABLED=0 timeout 60 grok inspect 2>/dev/null) \
      | sed -n 's/^ *└ \([A-Za-z0-9._-]*\) .* bundled.*$/\1/p' > "$f.new"
    [ -s "$f.new" ] && mv -f "$f.new" "$f" || rm -f "$f.new"
  fi
  cat "$f" 2>/dev/null
}

run_grok() {
  local h=$S/grok-home g=$HOME/.grok f sigs note
  # sessions/ and logs/ must be links before grok first writes them, or a chat's would stay in its own home
  mkdir -p "$h" "$g/sessions" "$g/logs"
  keep_login "$h/auth.json" "$g/auth.json"
  for f in "$g"/* "$g"/.[!.]*; do
    [ -e "$f" ] || continue
    [ "${f##*/}" = config.toml ] || ln -sfn "$f" "$h/${f##*/}"
  done
  ( umask 077
    { awk -v lean="$([ "$DEV" = 1 ] || echo 1)" '/^\[/ { skip = /^\[mcp_servers[.\]]/ || (lean && /^\[(skills|compat[.]codex)\]/) }
        !skip && !/^disabled_mcp_servers/' "$g/config.toml" 2>/dev/null
      printf '\n[mcp_servers.phone]\nurl = "%s"\ntool_timeout_sec = 600\n\n[mcp_servers.phone.headers]\nAuthorization = "Bearer %s"\n' \
        "$URL/mcp?chat=$SID" "$TOKEN"
      for n in $(jq -r '.[].name' <<<"$EXTRA"); do
        printf '\n[mcp_servers.%s]\nurl = "%s"\ntool_timeout_sec = 600\n\n[mcp_servers.%s.headers]\nAuthorization = "Bearer %s"\n' \
          "$n" "$URL/mcpx/$n" "$n" "$TOKEN"
      done
      if [ "$DEV" != 1 ]; then
        printf '\n[skills]\ndisabled = [%s]\n\n[compat.codex]\nskills = false\nhooks = false\n' \
          "$(grok_bundled_skills | sed 's/.*/"&"/' | paste -sd, -)"
      fi
    } > "$h/config.toml" )
  # the phone's tools with their arguments, "tap(element?, x?, y?)": grok otherwise looks each one up first (search_tool)
  sigs=$(curl -s -m 10 -X POST -H "Authorization: Bearer $TOKEN" -H 'Content-Type: application/json' \
    -H 'Accept: application/json, text/event-stream' --data '{"jsonrpc":"2.0","id":1,"method":"tools/list"}' \
    "$URL/mcp?chat=$SID" | jq -r '[.result.tools[] | (.inputSchema.required // []) as $req | "\(.name)(" + ((.inputSchema.properties // {})
    | keys_unsorted | map(. as $k | if ($req | index($k)) != null then $k else $k + "?" end) | join(", ")) + ")"]
    | join(", ")' 2>/dev/null)
  note="In this app the phone tools are on the MCP server named \"phone\". Call them right away with use_tool \
(tool_name \"phone__<tool>\", e.g. phone__read_screen, and tool_input with its arguments${sigs:+ as listed here; ? marks an \
optional one: $sigs}). You don't need search_tool for them.$(mcp_extra_note | sed 's/use their tools/call them with use_tool as "<server>__<tool>"/')"
  [ "$DEV" = 1 ] || note="$note Shell commands are not available in this chat; don't try them."
  # --rules adds Buddy's instructions to grok's own, on every run (as --append-system-prompt does for Claude Code)
  local args=(-p "$MSG" --output-format streaming-messages-json --rules "$SYSTEM"$'\n\n'"$note" --allow 'MCPTool(phone__*)')
  for n in $(jq -r '.[].name' <<<"$EXTRA"); do args+=(--allow "MCPTool(${n}__*)"); done
  case "$DEV" in
    1) args+=(--always-approve) ;;
    rule) args+=(--tools use_tool --disable-web-search) ;;  # use_tool and search_tool: the phone only
    *) if [ -d "$S/files" ]; then args+=(--tools read_file,web_search,web_fetch); else args+=(--tools web_search,web_fetch); fi
       args+=(--allow WebFetch) ;;
  esac
  [ "$DEV" = 1 ] || args+=(--no-subagents --no-plan)
  [ -s "$S/grok-session" ] && args+=(-r "$(cat "$S/grok-session")")
  [ -n "${MODEL:-}" ] && args+=(-m "$MODEL")
  [ -n "${EFFORT:-}" ] && args+=(--effort "$EFFORT")
  local lean=()
  [ "$DEV" = 1 ] || lean=(GROK_MEMORY=0 GROK_CLAUDE_SKILLS_ENABLED=0 GROK_CURSOR_SKILLS_ENABLED=0 GROK_CLAUDE_RULES_ENABLED=0
    GROK_CURSOR_RULES_ENABLED=0 GROK_CLAUDE_AGENTS_ENABLED=0 GROK_CURSOR_AGENTS_ENABLED=0 GROK_CLAUDE_HOOKS_ENABLED=0
    GROK_CURSOR_HOOKS_ENABLED=0)
  cd "$CWD" && env "${lean[@]}" GROK_HOME=$h GROK_CLAUDE_MCPS_ENABLED=0 GROK_CURSOR_MCPS_ENABLED=0 GROK_DISABLE_AUTOUPDATER=1 \
    grok "${args[@]}" </dev/null 2>"$S/last-error.log"
  local status=$?
  # a token refresh that replaced the link with a file: keep the new login in the real folder
  f=$h/auth.json
  [ -f "$f" ] && [ ! -L "$f" ] && mv -f "$f" "$g/auth.json" && ln -sfn "$g/auth.json" "$f"
  return $status
}

# grok's streaming-messages-json is Claude Code's stream format; only the tool names differ. A phone tool comes as
# use_tool {tool_name:"phone__tap", tool_input}; its lookups (search_tool) and its thinking aren't shown. A step the
# run refused (headless grok can't ask) is only on stderr ("permission required: … was not run"): said under the steps.
stream_grok() {
  local line typ sid t=""
  rm -f "$S/grok-error"
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    [ "$line" = "$AGENT_END" ] && break
    typ=$(printf '%s' "$line" | jq -r '.type // empty' 2>/dev/null)
    case "$typ" in
      system)
        sid=$(printf '%s' "$line" | jq -r '.session_id // empty' 2>/dev/null)
        [ -n "$sid" ] && printf '%s' "$sid" > "$S/grok-session" ;;
      result)
        t=$(sed -n 's/^permission required: \(.*\) was not run.*/\1/p' "$S/last-error.log" 2>/dev/null | sort -u | paste -sd, - | sed 's/,/, /g')
        [ -n "$t" ] && jq -cn --arg t "Not allowed in this chat: $t" --arg s "$SID" '{type:"buddy_step", text:$t, buddy_session:$s}' | post
        printf '%s' "$line" | jq -r 'select(.is_error) | (.errors // []) | join("; ") | if . == "" then "the request failed" else . end' \
          2>/dev/null > "$S/grok-error" ;;
    esac
    printf '%s' "$line" | jq -c --arg s "$SID" --arg denied "$t" '
      (if .type == "system" then {type, subtype, session_id, model}
      elif .type == "assistant" then
        .message.content |= [.[] | select(.type == "text" or (.type == "tool_use" and .name != "search_tool"))
          | if .type == "text" then . else
              (.input // {}) as $in | .name as $t
              | if $t == "use_tool" then
                  {type, name:("mcp__" + ($in.tool_name // "")),
                   input:(($in.tool_input // {}) | if type == "string" then (fromjson? // {}) else . end)}
                elif ($t | test("^[A-Za-z_][A-Za-z0-9_-]*__")) then {type, name:("mcp__" + $t), input:$in}
                elif $t == "run_terminal_command" or $t == "run_terminal_cmd" then {type, name:"Bash", input:{command:($in.command // "")}}
                elif $t == "write" or $t == "search_replace" then {type, name:"Edit", input:{file_path:($in.file_path // $in.target_file // "")}}
                elif $t == "read_file" then {type, name:"Read", input:{file_path:($in.target_file // $in.file_path // $in.path // "")}}
                elif $t == "web_search" then {type, name:"WebSearch", input:{query:($in.query // "")}}
                elif $t == "web_fetch" then {type, name:"WebFetch", input:{url:($in.url // "")}}
                else {type, name:$t, input:$in} end
            end]
        | select(.message.content | length > 0) | {type, message:{content:.message.content}}
      elif .type == "result" and .is_error then
        {type, subtype, is_error, result:(if $denied != "" and .errors == ["cancelled"] then "Grok stopped after this chat refused: " + $denied
          else "Grok: " + ((.errors // []) | join("; ") | if . == "" then "the request failed" else . end) end)}
      elif .type == "result" then {type, subtype, result:(.result // "")}
      elif .type == "error" then {type:"result", subtype:"error", is_error:true, result:("Grok: " + (.message // "error"))}
      else empty end) | . + {buddy_session:$s}' 2>/dev/null | while IFS= read -r ev; do printf '%s' "$ev" | post; done
  done
}

# -------------------------------------------------------------------- Copilot
# GitHub Copilot CLI, through Buddy's wrapper (linux/buddy-copilot, linked as ~/.local/bin/copilot: its own executable
# fails under proot). Each run gets the phone (?chat=, 10-minute timeout: an approval card may wait for the user) and
# the user's MCP servers set up in Buddy from a file of its own, as the token can't go on the command line. Buddy's
# instructions go in as a custom instructions folder, which Copilot reads on every run. A -p run refuses what nothing
# allows (no one to ask): the phone is allowed. Normal mode offers only the phone, web fetch, file reads (the chat's
# attachments and Buddy's guide) and skills; a rule's run only the phone; developer mode everything but sub-agents,
# which Buddy can't show (as for Claude Code).
run_copilot() {
  local c=$S/copilot n f sys=$SYSTEM
  mkdir -p "$c/instructions/.github/instructions" "$c/read"
  ( umask 077
    jq -n --arg url "$URL/mcp?chat=$SID" --arg base "$URL/mcpx/" --arg auth "Bearer $TOKEN" --argjson x "$EXTRA" \
      '{mcpServers:({phone:{type:"http", url:$url, headers:{Authorization:$auth}, tools:["*"], timeout:600000}}
        + ($x | map({key:.name, value:{type:"http", url:($base + .name), headers:{Authorization:$auth}, tools:["*"],
            timeout:600000}}) | from_entries))}' > "$c/mcp.json" )
  # (--prompt=: a message that starts with "-" would be read as an option)
  local args=("--prompt=$MSG" --output-format json --additional-mcp-config "@$c/mcp.json" --allow-tool phone
    --no-ask-user --no-auto-update)
  for n in $(jq -r '.[].name' <<<"$EXTRA"); do args+=(--allow-tool "$n"); done
  case "$DEV" in
    1) args+=(--allow-all --excluded-tools task read_agent list_agents write_agent) ;;
    rule) args+=(--available-tools phone --disable-builtin-mcps) ;;
    *) # a file is only read inside the folders it is given: the attachments, and a copy of Buddy's guide, whose
       # path the instructions name instead (the rest of ~/.buddy has other chats' files)
       cp -f "$D/GUIDE.md" "$c/read/GUIDE.md" 2>/dev/null && sys=${sys//$D\/GUIDE.md/$c/read/GUIDE.md}
       args+=(--available-tools phone $(jq -r '.[].name' <<<"$EXTRA") view web_fetch skill --allow-all-urls
         --add-dir "$c/read" --disallow-temp-dir --disable-builtin-mcps)
       [ -d "$S/files" ] && args+=(--add-dir "$S/files") ;;
  esac
  # the user's own servers in ~/.copilot/mcp-config.json stay out of phone chats (Buddy's MCP servers come above, and
  # replace one of the same name, like the phone that Settings > Phone tools adds there)
  if [ "$DEV" != 1 ]; then
    for n in $(sed '/^ *\/\//d' "$HOME/.copilot/mcp-config.json" 2>/dev/null | jq -r --argjson x "$EXTRA" \
        '(.mcpServers // {}) | keys - ["phone"] - [$x[].name] | .[]' 2>/dev/null); do
      args+=(--disable-mcp-server "$n")
    done
  fi
  { printf -- '---\napplyTo: "**"\n---\n%s\n' "$sys"
    [ "$DEV" = 1 ] || printf '\nShell commands are not available in this chat; don'"'"'t try them.\n'
  } > "$c/instructions/.github/instructions/buddy.instructions.md"
  for f in "${IMGS[@]}"; do args+=(--attachment "$f"); done
  [ -s "$S/copilot-session" ] && args+=("--resume=$(cat "$S/copilot-session")")
  [ -n "${MODEL:-}" ] && args+=(--model "$MODEL")
  [ -n "${EFFORT:-}" ] && args+=(--reasoning-effort "$EFFORT")
  rm -f "$S/copilot-error"
  cd "$CWD" && COPILOT_CUSTOM_INSTRUCTIONS_DIRS=$c/instructions COPILOT_SKILLS_DIRS=$HOME/.agents/skills \
    "$COPILOT" "${args[@]}" </dev/null 2>"$S/last-error.log"
}

# Translate Copilot's JSONL events into the Claude Code stream format. Text comes whole (assistant.message, its
# deltas are left out), steps when a tool starts (MCP tools carry their server and tool names), its own bookkeeping
# isn't shown. A step the chat refused (headless Copilot can't ask) ends with error code "denied": said under the
# steps. session.error is the run's failure, in Copilot's words.
stream_copilot() {
  local line typ id
  declare -A tools=()
  rm -f "$S/copilot-error"
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    [ "$line" = "$AGENT_END" ] && break
    printf '%s\n' "$line" >> "$S/copilot-last.jsonl"   # the run's raw events stay, for checking how Copilot reports them
    typ=$(printf '%s' "$line" | jq -r '.type // empty' 2>/dev/null)
    case "$typ" in
      session.start)
        id=$(printf '%s' "$line" | jq -r '.data.sessionId // empty' 2>/dev/null)
        [ -n "$id" ] && printf '%s' "$id" > "$S/copilot-session" ;;
      tool.execution_start)
        id=$(printf '%s' "$line" | jq -r '.data.toolCallId // empty' 2>/dev/null)
        # what it was, for a refusal: "read /etc/hosts", "git push", "tap"
        [ -n "$id" ] && tools[$id]=$(printf '%s' "$line" | jq -r '.data | (.arguments // {}) as $in
          | if .toolName == "view" then "read " + ($in.path // "") elif .toolName == "bash" then ($in.command // "bash")
            else .mcpToolName // .toolName // "" end' 2>/dev/null) ;;
      tool.execution_complete)
        if [ "$(printf '%s' "$line" | jq -r '.data.error.code // empty' 2>/dev/null)" = denied ]; then
          id=$(printf '%s' "$line" | jq -r '.data.toolCallId // empty' 2>/dev/null)
          jq -cn --arg t "Not allowed in this chat: ${tools[$id]:-a step}" --arg s "$SID" \
            '{type:"buddy_step", text:$t, buddy_session:$s}' | post
        fi
        continue ;;
      session.error)
        printf '%s' "$line" | jq -r '.data.message // "the request failed"' 2>/dev/null > "$S/copilot-error" ;;
    esac
    printf '%s' "$line" | jq -c --arg s "$SID" --arg failed "$([ -s "$S/copilot-error" ] && echo 1)" '
      .data as $d
      | (if .type == "session.start" or .type == "session.resume" then {type:"system", subtype:"init",
          model:(($d.selectedModel // "") | if . == "auto" then "" else . end)}
          + (if $d.sessionId then {session_id:$d.sessionId} else {} end)
      # the model Copilot picked or switched to, shown when the chat is on "Default"
      elif .type == "session.auto_mode_resolved" and ($d.chosenModel // "") != "" then {type:"system", subtype:"model", model:$d.chosenModel}
      elif .type == "session.model_change" and ($d.newModel // "auto") != "auto" then {type:"system", subtype:"model", model:$d.newModel}
      elif .type == "assistant.message" and (($d.content // "") | test("\\S")) then
        {type:"assistant", message:{content:[{type:"text", text:$d.content}]}}
      elif .type == "tool.execution_start" then
        ($d.arguments // {}) as $in | ($d.toolName // "") as $t
        | if ($d.mcpServerName // "") != "" then {type:"assistant", message:{content:[{type:"tool_use",
              name:("mcp__" + $d.mcpServerName + "__" + ($d.mcpToolName // "")), input:$in}]}}
          elif $t | IN("read_bash", "write_bash", "stop_bash", "list_bash", "report_intent", "sql", "session_store_sql",
              "fetch_copilot_cli_documentation", "task_complete", "update_todo") then empty
          else {type:"assistant", message:{content:[{type:"tool_use",
              name:({bash:"Bash", view:"Read", create:"Edit", edit:"Edit", str_replace_editor:"Edit", apply_patch:"Edit",
                     web_fetch:"WebFetch", web_search:"WebSearch", grep:"Grep", glob:"Glob", skill:"Skill",
                     task:"Task"}[$t] // $t),
              input:(if $t == "bash" then {command:($in.command // "")}
                     elif $t | IN("view", "create", "edit", "str_replace_editor") then {file_path:($in.path // "")}
                     elif $t == "web_fetch" then {url:($in.url // "")} else $in end)}]}}
          end
      elif .type == "session.error" then {type:"result", subtype:"error", is_error:true,
        result:("Copilot: " + ($d.message // "the request failed"))}
      # its last word: a failed run already said why (session.error) or leaves it to its exit status and stderr
      elif .type == "result" and (.exitCode // 1) == 0 and $failed == "" then {type:"result", subtype:"success", result:""}
      else empty end) | . + {buddy_session:$s}' 2>/dev/null | while IFS= read -r ev; do printf '%s' "$ev" | post; done
  done
}

# ------------------------------------------------------------------------- Pi
# Pi (pi.dev) reads MCP servers from its agent folder, but each chat needs its own phone address (?chat=). So every
# run gets its own PI_CODING_AGENT_DIR: the phone (and Buddy's MCP servers) declared to the model directly, with a
# 10-minute timeout (an approval card may wait for the user) and Buddy's token from the environment, and everything
# else (logins, settings, sessions) linked to the real ~/.pi/agent. Pi has no permission checks of its own, so a chat
# only gets the tools it may use: normal mode and a rule's run the phone (a normal chat also Buddy's MCP servers, and
# its attachments in the message), developer mode Pi's own read, bash, edit and write as well.
# A model of a service saved in Buddy: the chat's folder gets a models.json of its own, the user's with one more
# provider, "buddy-<service>", which is Buddy's relay (Chat Completions when the service has an OpenAI-style address,
# as for OpenCode, else Anthropic's Messages), again with Buddy's token from the environment.
run_pi() {
  local h=$S/pi-home g=$HOME/.pi/agent f n id
  mkdir -p "$h" "$g/sessions"
  # what an earlier run wrote for this chat alone goes first: the user's own files are linked again below, and
  # nothing is ever written through a link into their folder
  for f in models.json settings.json; do
    [ -L "$h/$f" ] || rm -f "$h/$f"
  done
  keep_login "$h/auth.json" "$g/auth.json"
  for f in "$g"/* "$g"/.[!.]*; do
    [ -e "$f" ] || continue
    [ "${f##*/}" = mcp.json ] || ln -sfn "$f" "$h/${f##*/}"
  done
  if [ -n "$SVC" ]; then
    local own
    own=$(jq -c 'select(type == "object")' "$g/models.json" 2>/dev/null)
    [ -n "$own" ] || own='{}'
    rm -f "$h/models.json"
    # the chat's model is listed even when the service didn't name it (one typed in by hand). Sizes as the service
    # said them; an answer of at most a quarter of the context, and never more than Pi's own 16384 (services turn
    # down a request that asks for more than the model can write). Pictures only for a model known to take them:
    # Pi leaves them out for the others.
    jq --argjson own "$own" --arg url "$URL/llm/$SVC" --arg id "buddy-$SVC" --arg m "$SVCM" '
      ((.models // {}) | if has($m) then . else . + {($m): {name: $m}} end) as $models
      | $own + {providers: (($own.providers // {}) + {($id): ({name: (.name // $id), apiKey: "$BUDDY_TOKEN"}
          + (if (.openai // "") != "" then {baseUrl: ($url + "/o"), api: "openai-completions"}
             else {baseUrl: ($url + "/a"), api: "anthropic-messages"} end)
          + {models: [$models | to_entries[] | {id: .key, name: (if (.value.name // "") == "" then .key else .value.name end)}
              + (if (.value.window // 0) > 0 then {contextWindow: .value.window,
                  maxTokens: ([.value.window / 4, 16384] | min | floor)} else {} end)
              + (if .value.image == true then {input: ["text", "image"]} else {} end)]})})}' \
      "$D/providers/$SVC.json" > "$h/models.json" || return 1
    # a model on the user's own computer can read for many minutes before its first word: 15, as Buddy waits
    if [ "$(jq -r '.local // false' "$D/providers/$SVC.json" 2>/dev/null)" = true ]; then
      own=$(jq -c 'select(type == "object")' "$g/settings.json" 2>/dev/null)
      [ -n "$own" ] || own='{}'
      rm -f "$h/settings.json"
      jq -n --argjson own "$own" '$own + {httpIdleTimeoutMs: 900000}' > "$h/settings.json"
    fi
  fi
  jq -n --arg url "$URL/mcp?chat=$SID" --arg base "$URL/mcpx/" --argjson x "$EXTRA" \
    '{autoEnableCodemode:false, mcpServers:({phone:{url:$url, headers:{Authorization:"Bearer ${BUDDY_TOKEN}"}, timeout:600,
        exposure:"direct"}}
      + ($x | map({key:.name, value:{url:($base + .name), headers:{Authorization:"Bearer ${BUDDY_TOKEN}"}, timeout:600,
        exposure:"direct"}}) | from_entries))}' > "$h/mcp.json"
  printf '%s\n' "$SYSTEM" > "$S/pi-system.md"
  [ "$DEV" = 1 ] || printf '\nShell commands are not available in this chat; don'"'"'t try them.\n' >> "$S/pi-system.md"
  # its session is named by Buddy: the same name opens it again, or starts it when it's gone
  [ -s "$S/pi-session" ] || printf 'buddy-%s-%s' "$SID" "$(date +%s)" > "$S/pi-session"
  id=$(cat "$S/pi-session")
  local args=(--mode json --session-id "$id" --append-system-prompt "$S/pi-system.md")
  # the tools are named on every run: a session keeps the set it last had (Linux tools switched on or off in between)
  if [ "$DEV" = 1 ]; then
    args+=(--tools "read,bash,edit,write,grep,find,ls,mcp__*")
  else
    local t="mcp__phone__*"
    for n in $(jq -r '.[].name' <<<"$EXTRA"); do t="$t,mcp__${n}__*"; done
    args+=(--tools "$t" --no-skills)
  fi
  if [ -n "$SVC" ]; then args+=(--model "buddy-$SVC/$SVCM")
  elif [ -n "${MODEL:-}" ]; then args+=(--model "$MODEL"); fi
  [ -n "${EFFORT:-}" ] && args+=(--thinking "$EFFORT")
  args+=(--)
  # attachments go in with the message, as a normal chat has no file reads: pictures, and files that are text (another
  # file would go in as its raw bytes)
  for f in "${ATT[@]}"; do
    case " ${IMGS[*]} " in *" $f "*) args+=("@$f"); continue ;; esac
    grep -Iq . "$f" 2>/dev/null && args+=("@$f")
  done
  # a message that starts with "@" would be taken for a file to attach ("@anna said…": "File not found"): a space
  # before it makes it a message again
  local msg=$MSG
  [[ "$msg" == @* ]] && msg=" $msg"
  cd "$CWD" && BUDDY_TOKEN=$TOKEN PI_CODING_AGENT_DIR=$h PI_SKIP_VERSION_CHECK=1 pi "${args[@]}" "$msg" \
    </dev/null 2>"$S/last-error.log"
  local status=$?
  # a login refreshed during the run replaced the link with a file: keep it in the real folder
  f=$h/auth.json
  [ -f "$f" ] && [ ! -L "$f" ] && mv -f "$f" "$g/auth.json" && ln -sfn "$g/auth.json" "$f"
  return $status
}

# Translate Pi's JSON events into the Claude Code stream format. A message comes whole at message_end (its deltas are
# left out), steps when a tool starts (MCP tools are already named mcp__<server>__<tool>). An assistant message that
# ends in error is kept until the run settles: Pi retries some failures itself (an overloaded service), and a later
# answer means it went through. The error left at the end is the run's, in Pi's words.
stream_pi() {
  local line typ settled=""
  rm -f "$S/pi-error"
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    [ "$line" = "$AGENT_END" ] && break
    printf '%s\n' "$line" >> "$S/pi-last.jsonl"   # the run's raw events stay, for checking how Pi reports them
    typ=$(printf '%s' "$line" | jq -r '.type // empty' 2>/dev/null)
    case "$typ" in
      session|message_end|tool_execution_start|agent_settled) ;;
      *) continue ;;
    esac
    if [ "$typ" = message_end ]; then
      case "$(printf '%s' "$line" | jq -r 'select(.message.role == "assistant") | .message.stopReason // "stop"' 2>/dev/null)" in
        error) printf '%s' "$line" | jq -r '.message.errorMessage // "the request failed"' 2>/dev/null > "$S/pi-error" ;;
        ?*) rm -f "$S/pi-error" ;;
      esac
    fi
    [ "$typ" = agent_settled ] && settled=1
    printf '%s' "$line" | jq -c --arg s "$SID" --arg error "$(cat "$S/pi-error" 2>/dev/null)" '
      (if .type == "session" then {type:"system", subtype:"init", session_id:.id}
      elif .type == "message_end" and .message.role == "assistant" then .message as $m
        | (select($m.stopReason != "error")
           | [$m.content[]? | select(.type == "text" and ((.text // "") | test("\\S"))) | {type:"text", text}]
           | select(length > 0) | {type:"assistant", message:{content:.}}),
          # the model that answered, shown when the chat is on "Default"
          (select(($m.model // "") != "") | {type:"system", subtype:"model", model:(($m.provider // "") as $p
            | if $p != "" then $p + "/" + $m.model else $m.model end)})
      elif .type == "tool_execution_start" then (.args // {}) as $in | (.toolName // "") as $t
        | select($t != "codemode" and $t != "tool_search")
        | {type:"assistant", message:{content:[{type:"tool_use",
            name:({bash:"Bash", read:"Read", edit:"Edit", write:"Edit", grep:"Grep", find:"Glob", ls:"Glob"}[$t] // $t),
            input:(if $t == "bash" then {command:($in.command // "")}
                   elif $t | IN("read", "edit", "write") then {file_path:($in.path // "")} else $in end)}]}}
      elif .type == "agent_settled" and $error != "" then {type:"result", subtype:"error", is_error:true, result:("Pi: " + $error)}
      elif .type == "agent_settled" and (.aborted | not) then {type:"result", subtype:"success", result:""}
      else empty end) | . + {buddy_session:$s}' 2>/dev/null | while IFS= read -r ev; do printf '%s' "$ev" | post; done
  done
  # it ended without settling (it was stopped, or it died) after an error: say it
  if [ -z "$settled" ] && [ -s "$S/pi-error" ]; then
    jq -cn --arg e "Pi: $(cat "$S/pi-error")" --arg s "$SID" '{type:"result", subtype:"error", is_error:true, result:$e, buddy_session:$s}' | post
  fi
}

# Tests (linux/test/run.sh): translate an agent's recorded output from stdin with its stream_ function and print the
# events instead of posting them.
if [ -n "${BUDDY_TEST_STREAM:-}" ]; then
  trap - EXIT
  post() { cat; echo; }
  "stream_$BUDDY_TEST_STREAM"
  exit 0
fi

# ------------------------------------------------------------------------ run
(
  trap - EXIT TERM INT HUP
  if [ "$BACKEND" = opencode ]; then
    if ! have opencode; then event buddy_error "OpenCode isn't installed yet. Install it in Buddy's Settings."; exit 0; fi
    ended run_opencode | stream_opencode
    status=${PIPESTATUS[0]}
    if [ "$status" -ne 0 ] && [ -s "$S/opencode-session" ] && grep -q -i -E 'not found|no such|session' "$S/last-error.log" 2>/dev/null; then
      rm -f "$S/opencode-session"   # old session is gone; retry as a new conversation
      ended run_opencode | stream_opencode
      status=${PIPESTATUS[0]}
    fi
    name=OpenCode
  elif [ "$BACKEND" = agy ]; then
    if ! have agy; then event buddy_error "Antigravity isn't installed yet. Install it in Buddy's Settings."; exit 0; fi
    # a rule's run must get no shell, files or web; agy's allow list can't promise that yet (see Account.runsRules)
    if [ "$DEV" = rule ]; then event buddy_error "Antigravity can't run notification rules yet. Pick another agent for this rule."; exit 0; fi
    # the last run's raw events stay in the session folder, for checking how agy reports its steps
    : > "$S/agy-last.jsonl"
    ended run_agy | stream_agy
    status=${PIPESTATUS[0]}
    # a refusal ended its turn without a word: nudge it on once, in the same conversation
    if [ -s "$S/agy-denied" ] && [ -s "$S/agy-conversation" ]; then
      MSG="(From Buddy, not the user) This chat doesn't allow that: $(cat "$S/agy-denied"). Carry on with the phone \
tools (call_mcp_tool, ServerName \"phone\") and finish the user's request."
      ended run_agy | stream_agy last
      status=${PIPESTATUS[0]}
    fi
    if [ -s "$S/agy-conversation" ] && grep -q -i -E 'conversation.*(not found|no such|unknown)' "$S/agy-error" "$S/last-error.log" 2>/dev/null; then
      rm -f "$S/agy-conversation"   # old conversation is gone; retry as a new one
      ended run_agy | stream_agy
      status=${PIPESTATUS[0]}
    fi
    # a failed turn (quota reached, …) is already in the chat from its result; agy also exits non-zero and prints
    # the same error with raw JSON, which would show it twice
    [ -s "$S/agy-error" ] && status=0
    name=Antigravity
  elif [ "$BACKEND" = grok ]; then
    if ! have grok; then event buddy_error "Grok isn't installed yet. Install it in Buddy's Settings."; exit 0; fi
    ended run_grok | stream_grok
    status=${PIPESTATUS[0]}
    if [ "$status" -ne 0 ] && [ -s "$S/grok-session" ] && grep -q -i -E 'session.*not found|failed to restore session' "$S/last-error.log" 2>/dev/null; then
      rm -f "$S/grok-session"   # old session is gone; retry as a new conversation
      ended run_grok | stream_grok
      status=${PIPESTATUS[0]}
    fi
    # a failed turn (not signed in, …) is already in the chat from its result; grok also exits non-zero and prints
    # the same error, which would show it twice
    [ -s "$S/grok-error" ] && status=0
    name=Grok
  elif [ "$BACKEND" = copilot ]; then
    if [ ! -x "$COPILOT" ]; then event buddy_error "Copilot isn't installed yet. Install it in Buddy's Settings."; exit 0; fi
    : > "$S/copilot-last.jsonl"
    ended run_copilot | stream_copilot
    status=${PIPESTATUS[0]}
    if [ "$status" -ne 0 ] && [ -s "$S/copilot-session" ] \
        && grep -q -i -E 'no session, task, or name matched|session.*(not found|does not exist)' "$S/last-error.log" 2>/dev/null; then
      rm -f "$S/copilot-session"   # old session is gone; retry as a new conversation
      ended run_copilot | stream_copilot
      status=${PIPESTATUS[0]}
    fi
    # a failed turn is already in the chat from its session.error; Copilot also exits non-zero
    [ -s "$S/copilot-error" ] && status=0
    name=Copilot
  elif [ "$BACKEND" = pi ]; then
    if ! have pi; then event buddy_error "Pi isn't installed yet. Install it in Buddy's Settings."; exit 0; fi
    : > "$S/pi-last.jsonl"
    ended run_pi | stream_pi
    status=${PIPESTATUS[0]}
    # a failed turn is already in the chat from its message; Pi may also exit non-zero
    [ -s "$S/pi-error" ] && status=0
    name=Pi
  elif [ "$BACKEND" = codex ]; then
    if ! have codex; then event buddy_error "Codex isn't installed yet. Install it in Buddy's Settings."; exit 0; fi
    ended run_codex | stream_codex
    status=${PIPESTATUS[0]}
    if [ "$status" -ne 0 ] && [ -s "$S/codex-thread" ] && grep -q -i -E 'not found|no such|unknown (thread|session)' "$S/last-error.log" 2>/dev/null; then
      rm -f "$S/codex-thread"   # old thread is gone; retry as a new conversation
      ended run_codex | stream_codex
      status=${PIPESTATUS[0]}
    fi
    name=Codex
  else
    if ! have claude; then event buddy_error "Claude Code isn't installed yet. Install it in Buddy's Settings."; exit 0; fi
    ended run_claude | stream_claude
    status=${PIPESTATUS[0]}
    if [ "$status" -ne 0 ] && grep -q -i 'no conversation found' "$S/last-error.log" 2>/dev/null; then
      rm -f "$S/claude-session"   # old session is gone; retry as a new conversation
      ended run_claude | stream_claude
      status=${PIPESTATUS[0]}
    fi
    name="Claude Code"
  fi
  if [ "$status" -ne 0 ] && [ "$status" -ne 143 ] && [ -s "$S/last-error.log" ]; then
    # the agent's own words: all of them, unless it wrote pages (then the end, and a mark that there was more)
    more=""; [ "$(wc -c < "$S/last-error.log")" -gt 4000 ] && more="… "
    event buddy_error "$name failed: $more$(tail -c 4000 "$S/last-error.log")"
  elif [ "$status" -gt 128 ] && [ "$status" -ne 143 ]; then
    # killed, and it said nothing: the chat would end without a word (the app drops this if the run said why itself)
    quiet_end "$name was killed (signal $((status - 128)))."
  elif [ "$status" -ne 0 ] && [ "$status" -ne 143 ]; then
    quiet_end "$name ended with exit status $status and said nothing."
  fi
) &
RUN=$!
echo "$RUN" > "$S/pid"
wait "$RUN" 2>/dev/null
rm -f "$S/pid"
exit 0 # (buddy_done: the EXIT trap)
